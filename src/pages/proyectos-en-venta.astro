---
import BaseLayout from '../layouts/BaseLayout.astro';

import ProjectsListingHero from '../components/sections/ProjectsListingHero.astro';
import ProjectsGrid from '../components/sections/ProjectsGrid.astro';

import heroImage from '../assets/img/sections/projects/hero.webp';
---

<BaseLayout
  title='Proyectos en Venta | Estrategia Urbana'
  description='Conoce los desarrollos inmobiliarios de Estrategia Urbana.'
>
  <ProjectsListingHero
    image={heroImage}
    title={['Conoce nuestros', 'desarrollos']}
    cta={{
      label: 'Agenda una cita',
      href: '/contacto',
    }}
  />

  <ProjectsGrid />
</BaseLayout>
