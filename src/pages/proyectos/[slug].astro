---
import type { GetStaticPaths } from 'astro';

import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ProjectHero from '../../components/sections/ProjectHero.astro';
import ProjectSubnav from '../../components/sections/ProjectSubnav.astro';

import ProjectIntro from '../../components/sections/ProjectIntro.astro';
import ProjectLocation from '../../components/sections/ProjectLocation.astro';
import ProjectAmenities from '../../components/sections/ProjectAmenities.astro';
import ProjectFloorplans from '../../components/sections/ProjectFloorplans.astro';
import ProjectGallery from '../../components/sections/ProjectGallery.astro';
import ProjectCollaborators from '../../components/sections/ProjectCollaborators.astro';

import ContactForm from '../../components/sections/ContactForm.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection(
    'projects',
    ({ data }) => data.detail?.visible === true,
  );

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },

    props: {
      projectId: project.id,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;

const project = await getEntry('projects', projectId);

if (!project) {
  throw new Error(`No se encontró el proyecto "${projectId}".`);
}

const { detail, location, seo } = project.data;

if (!detail || detail.visible !== true) {
  throw new Error(
    `El proyecto "${projectId}" no tiene una página de detalle pública.`,
  );
}

if (!location.address) {
  throw new Error(
    `El proyecto "${projectId}" no tiene una dirección definida.`,
  );
}

if (!seo) {
  throw new Error(
    `El proyecto "${projectId}" no tiene metadatos SEO definidos.`,
  );
}

const {
  hero,
  metrics,
  intro,
  location: locationSection,
  amenities,
  floorplans,
  gallery,
  collaborators,
} = detail;

/*
 * =========================
 * PROJECT NAVIGATION
 * =========================
 *
 */

const projectNavigation = [
  {
    label: 'Proyecto',
    href: '#project',
  },
  {
    label: 'Ubicación',
    href: '#location',
  },

  ...(amenities?.visible === true
    ? [{ label: 'Amenidades', href: '#features' }]
    : []),

  ...(floorplans?.visible === true
    ? [{ label: 'Tipologías', href: '#typologies' }]
    : []),

  ...(gallery?.visible === true
    ? [{ label: 'Galería', href: '#gallery' }]
    : []),
];

const detailMap = location.map?.detail;

const projectLocationMap =
  detailMap?.visible === true && location.coordinates
    ? {
        center: location.coordinates,
        zoom: detailMap.zoom,
      }
    : null;
---

<BaseLayout
  title={seo.title}
  description={seo.description}
  ogImage={`/seo/${project.id}.jpg`}
  ogImageAlt={`${project.data.name} | Estrategia Urbana`}
  headerTheme='overlay'
>
  <ProjectSubnav slot='fixed-ui' mode='fixed' navigation={projectNavigation} />

  <ProjectHero
    image={hero.image}
    alt={hero.alt}
    title={hero.title}
    eyebrow={hero.eyebrow}
    stats={metrics}
    cta={hero.cta}
  />

  <ProjectSubnav mode='flow' navigation={projectNavigation} />

  <ProjectIntro
    index={intro.index}
    title={intro.title}
    body={intro.body}
    address={location.address}
    image={intro.image.image}
    alt={intro.image.alt}
    decoration={intro.decoration.image}
    metrics={metrics}
  />

  <ProjectLocation
    index={locationSection.index}
    title={locationSection.title}
    body={locationSection.body}
    projectName={project.data.name}
    logo={project.data.brand?.logo ?? null}
    map={projectLocationMap}
  />

  {
    amenities?.visible === true && (
      <ProjectAmenities
        index={amenities.index}
        title={amenities.title}
        eyebrow={amenities.eyebrow}
        items={amenities.items}
      />
    )
  }

  {
    floorplans?.visible === true && (
      <ProjectFloorplans
        index={floorplans.index}
        title={floorplans.title}
        items={floorplans.items}
      />
    )
  }

  {
    gallery?.visible === true && (
      <ProjectGallery
        index={gallery.index}
        title={gallery.title}
        note={gallery.note}
        items={gallery.items}
      />
    )
  }

  {
    collaborators?.visible === true && (
      <ProjectCollaborators
        index={collaborators.index}
        items={collaborators.items}
      />
    )
  }

  <ContactForm projectInterest={project.data.name} />
</BaseLayout>
