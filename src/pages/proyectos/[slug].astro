---
import type { GetStaticPaths } from 'astro';

import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ProjectHero from '../../components/sections/ProjectHero.astro';
import ProjectSubnav from '../../components/sections/ProjectSubnav.astro';

import ProjectIntro from '../../components/sections/ProjectIntro.astro';
import ProjectLocation from '../../components/sections/ProjectLocation.astro';
import ProjectAmenities from '../../components/sections/ProjectAmenities.astro';
import ProjectFloorplans from '../../components/sections/ProjectFloorplans.astro';

export const getStaticPaths = (async () => {
  const projects = await getCollection(
    'projects',
    ({ data }) => data.detail?.visible === true,
  );

  return projects.map((project) => ({
    params: {
      slug: project.id,
    },

    props: {
      projectId: project.id,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  projectId: string;
}

const { projectId } = Astro.props;

const project = await getEntry('projects', projectId);

if (!project) {
  throw new Error(`No se encontró el proyecto "${projectId}".`);
}

const { detail, location } = project.data;

if (!detail || detail.visible !== true) {
  throw new Error(
    `El proyecto "${projectId}" no tiene una página de detalle pública.`,
  );
}

if (!location.address) {
  throw new Error(
    `El proyecto "${projectId}" no tiene una dirección definida.`,
  );
}

const {
  hero,
  metrics,
  intro,
  location: locationSection,
  amenities,
  floorplans,
} = detail;

const detailMap = location.map?.detail;

const projectLocationMap =
  detailMap?.visible === true && location.coordinates
    ? {
        center: location.coordinates,
        zoom: detailMap.zoom,
      }
    : null;
---

<BaseLayout
  title={`${project.data.name} | Estrategia Urbana`}
  description={`Conoce ${project.data.name}, desarrollo de Estrategia Urbana.`}
  headerTheme='overlay'
>
  <ProjectHero
    image={hero.image}
    alt={hero.alt}
    title={hero.title}
    eyebrow={hero.eyebrow}
    stats={metrics}
    cta={hero.cta}
  />

  <ProjectSubnav />

  <ProjectIntro
    index={intro.index}
    title={intro.title}
    body={intro.body}
    address={location.address}
    image={intro.image.image}
    alt={intro.image.alt}
    decoration={intro.decoration.image}
    metrics={metrics}
  />

  <ProjectLocation
    index={locationSection.index}
    title={locationSection.title}
    body={locationSection.body}
    projectName={project.data.name}
    logo={project.data.brand?.logo ?? null}
    map={projectLocationMap}
  />

  {
    amenities?.visible === true && (
      <ProjectAmenities
        index={amenities.index}
        title={amenities.title}
        eyebrow={amenities.eyebrow}
        items={amenities.items}
      />
    )
  }

  {
    floorplans?.visible === true && (
      <ProjectFloorplans
        index={floorplans.index}
        title={floorplans.title}
        items={floorplans.items}
      />
    )
  }
</BaseLayout>
