---
import BaseLayout from '../layouts/BaseLayout.astro';

import HomeHero from '../components/sections/HomeHero.astro';
import HomeProjectsIntro from '../components/sections/HomeProjectsIntro.astro';
import HomeProjectsGrid from '../components/sections/HomeProjectsGrid.astro';
import HomeFloatingCTA from '../components/ui/HomeFloatingCTA.astro';
import HomePartners from '../components/sections/HomePartners.astro';
import HomeTeamIntro from '../components/sections/HomeTeamIntro.astro';
import HomeManifesto from '../components/sections/HomeManifesto.astro';
import HomeStats from '../components/sections/HomeStats.astro';

import heroImage from '../assets/img/home/hero-banner.webp';
import heroMark from '../assets/img/logos/logo-marca.svg';
---

<BaseLayout
  title='Estrategia Urbana'
  description='Desarrollos inmobiliarios de Estrategia Urbana.'
>
  <HomeHero image={heroImage} mark={heroMark} />

  <HomeProjectsIntro />
  <HomeProjectsGrid />
  <HomePartners />
  <HomeTeamIntro />
  <HomeManifesto />
  <HomeStats />
  <HomeFloatingCTA slot='fixed-ui' />
</BaseLayout>
