---
import type { GetStaticPaths } from 'astro';

import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

import ZoneHero from '../../components/sections/ZoneHero.astro';
import ZoneSwitcher from '../../components/sections/ZoneSwitcher.astro';
import ZoneIntro from '../../components/sections/ZoneIntro.astro';
import ZoneMap from '../../components/sections/ZoneMap.astro';
import ZoneGallery from '../../components/sections/ZoneGallery.astro';
import ZoneProjects from '../../components/sections/ZoneProjects.astro';

export const getStaticPaths = (async () => {
  const zones = await getCollection('zones');

  return zones.map((zone) => ({
    params: {
      slug: zone.id,
    },

    props: {
      zoneId: zone.id,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  zoneId: string;
}

const { zoneId } = Astro.props;

const zone = await getEntry('zones', zoneId);

if (!zone) {
  throw new Error(`No se encontró la zona "${zoneId}".`);
}

const navigationZones = (
  await getCollection('zones', ({ data }) => data.navigation.visible)
).sort((a, b) => a.data.navigation.order - b.data.navigation.order);
---

<BaseLayout
  title={zone.data.seo.title}
  description={zone.data.seo.description}
  headerTheme='overlay'
>
  <ZoneHero
    image={zone.data.hero.image}
    alt={zone.data.hero.alt}
    title={zone.data.hero.title}
    subtitle={zone.data.hero.subtitle}
  />

  <ZoneSwitcher zones={navigationZones} currentZoneId={zone.id} />

  <ZoneIntro
    index={zone.data.intro.index}
    title={zone.data.intro.title}
    body={zone.data.intro.body}
    image={zone.data.intro.image}
    alt={zone.data.intro.alt}
  />

  <ZoneMap center={zone.data.map.center} zoom={zone.data.map.zoom} />

  <ZoneGallery gallery={zone.data.gallery} />

  <ZoneProjects zoneId={zone.id} zoneName={zone.data.name} />
</BaseLayout>
