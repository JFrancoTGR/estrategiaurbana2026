---
import type { GetStaticPaths } from 'astro';

import { getCollection, getEntry } from 'astro:content';

import BaseLayout from '../../layouts/BaseLayout.astro';

export const getStaticPaths = (async () => {
  const zones = await getCollection('zones');

  return zones.map((zone) => ({
    params: {
      slug: zone.id,
    },

    props: {
      zoneId: zone.id,
    },
  }));
}) satisfies GetStaticPaths;

interface Props {
  zoneId: string;
}

const { zoneId } = Astro.props;

const zone = await getEntry('zones', zoneId);

if (!zone) {
  throw new Error(`No se encontró la zona "${zoneId}".`);
}
---

<BaseLayout
  title={zone.data.seo.title}
  description={zone.data.seo.description}
  headerTheme='light'
>
  <section class='zone-bootstrap'>
    <div class='page-shell'>
      <span class='zone-bootstrap__market'>
        {zone.data.market.toUpperCase()}
      </span>

      <h1>{zone.data.hero.title}</h1>

      <p>{zone.data.hero.subtitle}</p>
    </div>
  </section>
</BaseLayout>

<style>
  .zone-bootstrap {
    min-height: 60vh;

    display: flex;
    align-items: center;

    padding-block: 160px 96px;
  }

  .zone-bootstrap__market {
    display: block;

    margin-bottom: 16px;

    font-size: 0.6875rem;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  h1 {
    margin: 0;

    font-size: clamp(3rem, 7vw, 7rem);
    font-weight: 400;
    line-height: 0.95;
  }

  p {
    margin-top: 20px;
  }
</style>
