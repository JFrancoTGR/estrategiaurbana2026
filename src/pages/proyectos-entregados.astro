---
import BaseLayout from '../layouts/BaseLayout.astro';

import ProjectsListingHero from '../components/sections/ProjectsListingHero.astro';
import DeliveredProjectsGrid from '../components/sections/DeliveredProjectsGrid.astro';

import heroImage from '../assets/img/sections/delivered-projects/hero.webp';
---

<BaseLayout
  title='Proyectos Entregados | Estrategia Urbana'
  description='Conoce algunos de los proyectos entregados por Estrategia Urbana.'
>
  <ProjectsListingHero
    image={heroImage}
    title={['Proyectos', 'entregados']}
    cta={{
      label: 'Agenda una cita',
      href: '/contacto',
    }}
  />

  <DeliveredProjectsGrid />
</BaseLayout>
