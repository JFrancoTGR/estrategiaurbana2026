---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;

const { name, location, delivered } = project.data;

if (!delivered || delivered.visible !== true) {
  throw new Error(
    `DeliveredProjectCard requiere un proyecto entregado visible: "${name}".`,
  );
}

const { cover, gallery, units, levels } = delivered;

const neighborhood = location.label;

const galleryId = `delivered-${project.id}`;

const galleryData = gallery.map((item) => ({
  href: item.image.src,
  alt: item.alt,
}));
---

<article
  class='delivered-project-card'
  data-delivered-project-card
  data-gallery={JSON.stringify(galleryData)}
>
  <div class='delivered-project-card__media'>
    <Image
      src={cover.image}
      alt={cover.alt}
      class='delivered-project-card__image'
      loading='lazy'
    />

    <div class='delivered-project-card__overlay'>
      <h3 class='delivered-project-card__title'>
        {name}
      </h3>

      <div class='delivered-project-card__overlay-bottom'>
        <div class='delivered-project-card__meta'>
          <span>{neighborhood}</span>

          {units && <span>{units} unidades</span>}

          {levels && <span>{levels} niveles</span>}
        </div>

        <button
          type='button'
          class='delivered-project-card__gallery'
          data-gallery-trigger
          aria-label={`Ver galería de ${name}`}
        >
          Ver galería
          <span aria-hidden='true'>→</span>
        </button>
      </div>
    </div>
  </div>

  <div class='delivered-project-card__mobile-content'>
    <h3 class='delivered-project-card__mobile-title'>
      {name}
    </h3>

    <p class='delivered-project-card__mobile-location'>
      {location.label}
    </p>

    {
      (units || levels) && (
        <div class='delivered-project-card__mobile-meta'>
          {units && <span>{units} unidades</span>}

          {levels && <span>{levels} niveles</span>}
        </div>
      )
    }

    <button
      type='button'
      class='delivered-project-card__mobile-gallery'
      data-gallery-trigger
      aria-label={`Ver galería de ${name}`}
    >
      Ver galería
      <span aria-hidden='true'>→</span>
    </button>
  </div>
</article>

<style>
  .delivered-project-card {
    min-width: 0;
  }

  /* ------------------------------
     Media
  ------------------------------ */

  .delivered-project-card__media {
    position: relative;

    overflow: hidden;

    background-color: var(--color-surface-muted);
  }

  .delivered-project-card__image {
    display: block;

    width: 100%;

    aspect-ratio: 4 / 4.7;

    object-fit: cover;

    transition: transform 550ms var(--ease-premium);
  }

  /* ------------------------------
     Desktop overlay
  ------------------------------ */

  .delivered-project-card__overlay {
    position: absolute;

    inset: 0;

    display: flex;
    flex-direction: column;
    justify-content: space-between;
    align-items: flex-start;

    padding: clamp(20px, 2vw, 30px);

    background-color: rgb(240 239 239 / 94%);

    opacity: 0;

    pointer-events: none;

    transition: opacity 350ms var(--ease-premium);
  }

  .delivered-project-card__title {
    margin: 0;

    font-size: 0.875rem;
    font-weight: var(--font-weight-semibold);

    line-height: 1.2;
    letter-spacing: 0.02em;

    text-transform: uppercase;

    color: var(--color-red);
  }

  .delivered-project-card__overlay-bottom {
    width: 100%;

    transform: translateY(8px);

    transition: transform 350ms var(--ease-premium);
  }

  .delivered-project-card__meta {
    display: flex;
    flex-direction: column;

    gap: 6px;

    margin: 0;

    font-size: 0.75rem;
    line-height: 1.3;

    color: rgb(20 20 20 / 68%);
  }

  .delivered-project-card__gallery {
    margin-top: 24px;
  }

  /* ------------------------------
     Gallery CTA
  ------------------------------ */

  .delivered-project-card__gallery,
  .delivered-project-card__mobile-gallery {
    display: inline-flex;
    align-items: center;

    gap: 8px;

    padding: 0;

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.1em;

    text-transform: uppercase;

    color: var(--color-black);
    background: transparent;

    border: 0;

    cursor: pointer;
  }

  .delivered-project-card__gallery {
    margin-top: 24px;
  }

  .delivered-project-card__gallery span,
  .delivered-project-card__mobile-gallery span {
    transition: transform var(--duration-fast) var(--ease-premium);
  }

  .delivered-project-card__gallery:focus-visible,
  .delivered-project-card__mobile-gallery:focus-visible {
    outline: 1px solid var(--color-black);
    outline-offset: 4px;
  }

  @media (hover: hover) and (pointer: fine) {
    .delivered-project-card__media:hover .delivered-project-card__overlay,
    .delivered-project-card__media:focus-within
      .delivered-project-card__overlay {
      opacity: 1;

      pointer-events: auto;
    }

    .delivered-project-card__media:hover
      .delivered-project-card__overlay-bottom,
    .delivered-project-card__media:focus-within
      .delivered-project-card__overlay-bottom {
      transform: translateY(0);
    }

    .delivered-project-card__media:hover .delivered-project-card__image {
      transform: scale(1.015);
    }

    .delivered-project-card__gallery:hover span,
    .delivered-project-card__mobile-gallery:hover span {
      transform: translateX(3px);
    }
  }

  /* ------------------------------
     Mobile content
  ------------------------------ */

  .delivered-project-card__mobile-content {
    display: none;
  }

  /* ------------------------------
     Mobile
  ------------------------------ */

  @media (max-width: 767px) {
    .delivered-project-card__image {
      aspect-ratio: 4 / 4.65;
    }

    .delivered-project-card__overlay {
      display: none;
    }

    .delivered-project-card__mobile-content {
      background-color: var(--color-white);
      display: block;

      padding: 16px;
    }

    .delivered-project-card__mobile-title {
      color: var(--color-red);
      margin: 0;

      font-size: 0.875rem;
      font-weight: var(--font-weight-semibold);

      line-height: 1.2;

      text-transform: uppercase;
    }

    .delivered-project-card__mobile-location {
      margin-top: 4px;

      font-size: 0.75rem;

      color: rgb(20 20 20 / 58%);
    }

    .delivered-project-card__mobile-meta {
      display: flex;

      gap: 12px;

      margin-top: 10px;

      font-size: 0.6875rem;

      line-height: 1.2;
      letter-spacing: 0.04em;

      text-transform: uppercase;

      color: rgb(20 20 20 / 58%);
    }

    .delivered-project-card__mobile-gallery {
      margin-top: 16px;
    }
  }
</style>
