---
interface Props {
  event: {
    title: string;
    type: string;
    startsAt: string;
    endsAt: string;
    zone: string;
    city: string;
    href: string;
  };
}

const { event } = Astro.props;

const timeZone = 'America/Mexico_City';

const startsAt = new Date(event.startsAt);
const endsAt = new Date(event.endsAt);

const day = new Intl.DateTimeFormat('es-MX', {
  day: '2-digit',
  timeZone,
}).format(startsAt);

const monthYear = new Intl.DateTimeFormat('es-MX', {
  month: 'long',
  year: 'numeric',
  timeZone,
})
  .format(startsAt)
  .toUpperCase();

const formatTime = (date: Date) =>
  new Intl.DateTimeFormat('es-MX', {
    hour: '2-digit',
    minute: '2-digit',
    hour12: false,
    timeZone,
  }).format(date);
---

<article class='event-card'>
  <div class='event-card__meta'>
    <div class='event-card__date'>
      <span class='event-card__day font-editorial'>
        {day}
      </span>

      <span class='event-card__month'>
        {monthYear}
      </span>
    </div>

    <p class='event-card__type'>
      {event.type}
    </p>
  </div>

  <div class='event-card__body'>
    <h3 class='event-card__title font-editorial'>
      {event.title}
    </h3>

    <div class='event-card__details'>
      <p>
        {event.zone} · {event.city}
      </p>

      <p>
        {formatTime(startsAt)} - {formatTime(endsAt)} HRS
      </p>
    </div>

    <a
      class='event-card__cta'
      href={event.href}
    >
      RESERVAR LUGAR
      <span aria-hidden='true'>→</span>
    </a>
  </div>
</article>

<style>
  .event-card {
    min-height: 296px;

    display: flex;
    flex-direction: column;
    justify-content: space-between;

    padding: clamp(20px, 2vw, 28px);

    border: 1px solid rgb(20 20 20 / 70%);

    color: var(--color-text);
    background-color: var(--color-background);
  }

  .event-card__meta {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 24px;
  }

  .event-card__date {
    display: flex;
    flex-direction: column;
  }

  .event-card__day {
    font-size: clamp(3rem, 3.7vw, 4.25rem);
    font-weight: var(--font-weight-regular);
    letter-spacing: -0.04em;
    line-height: 0.85;
  }

  .event-card__month {
    margin-top: 10px;

    font-family: var(--font-primary);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.2em;
    line-height: 1;

    color: rgb(20 20 20 / 52%);
  }

  .event-card__type {
    position: relative;

    margin: 4px 0 0;

    font-family: var(--font-primary);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.16em;
    line-height: 1;

    color: var(--color-red);
    text-transform: uppercase;
  }

  .event-card__type::before {
    content: '';

    display: inline-block;

    width: 3px;
    height: 3px;

    margin-right: 5px;

    border-radius: 50%;

    vertical-align: middle;

    background-color: currentColor;
  }

  .event-card__body {
    margin-top: clamp(38px, 4vw, 56px);
  }

  .event-card__title {
    margin: 0;

    font-size: clamp(1.35rem, 1.65vw, 1.7rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: -0.015em;
    line-height: 1.08;
  }

  .event-card__details {
    margin-top: 24px;

    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .event-card__details p {
    margin: 0;

    font-family: var(--font-primary);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.18em;
    line-height: 1;

    color: rgb(20 20 20 / 52%);
    text-transform: uppercase;
  }

  .event-card__cta {
    width: fit-content;

    margin-top: 24px;

    display: inline-flex;
    align-items: center;
    gap: 9px;

    font-family: var(--font-primary);
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.16em;
    line-height: 1;

    color: var(--color-red);
    text-decoration: none;
    text-transform: uppercase;

    transition:
      gap var(--duration-fast) var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .event-card__cta:hover {
      gap: 14px;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .event-card__cta {
      transition: none;
    }
  }
</style>