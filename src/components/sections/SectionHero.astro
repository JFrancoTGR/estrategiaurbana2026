---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;

  title: string[];

  cta?: {
    label: string;
    href: string;
  };
}

const { image, title, cta } = Astro.props;
---

<section class='section-hero' data-motion='section-hero'>
  <Image
    src={image}
    alt=''
    class='section-hero__image'
    loading='eager'
    fetchpriority='high'
    data-anim='media'
  />

  <div class='section-hero__content page-shell layout-grid'>
    <div class='section-hero__copy'>
      <h1 class='section-hero__title font-editorial' data-anim='title'>
        {title.map((line) => <span>{line}</span>)}
      </h1>

      {
        cta && (
          <a href={cta.href} class='section-hero__cta' data-anim='cta'>
            {cta.label}
          </a>
        )
      }
    </div>
  </div>
</section>

<style>
  .section-hero {
    position: relative;

    width: 100%;
    min-height: clamp(500px, 65svh, 740px);

    overflow: hidden;

    color: var(--color-white);
    background-color: var(--color-black);
  }

  /* ------------------------------
     Media
  ------------------------------ */

  .section-hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  /*
   * Dos funciones:
   *
   * 1. preservar legibilidad del navbar;
   * 2. reforzar contraste del copy inferior.
   */
  .section-hero::after {
    content: '';

    position: absolute;
    z-index: 1;
    inset: 0;

    background:
      linear-gradient(
        to bottom,
        rgb(0 0 0 / 22%) 0%,
        rgb(0 0 0 / 8%) 28%,
        transparent 48%
      ),
      linear-gradient(
        to top,
        rgb(0 0 0 / 34%) 0%,
        rgb(0 0 0 / 12%) 30%,
        transparent 58%
      );

    pointer-events: none;
  }

  /* ------------------------------
     Content
  ------------------------------ */

  .section-hero__content {
    position: relative;
    z-index: 2;

    min-height: clamp(500px, 65svh, 740px);

    align-items: end;
  }

  .section-hero__copy {
    grid-column: 1 / span 7;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    padding-bottom: clamp(64px, 6vw, 104px);
  }

  .section-hero__title {
    margin: 0;

    font-size: clamp(3.4rem, 5vw, 6rem);

    font-weight: var(--font-weight-regular);

    line-height: 0.92;
    letter-spacing: -0.04em;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 45%),
      0 4px 18px rgb(0 0 0 / 25%);
  }

  .section-hero__title span {
    display: block;
  }

  /* ------------------------------
     CTA
  ------------------------------ */

  .section-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 34px;
    padding: 14px 24px;

    font-family: var(--font-primary);

    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);

    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: var(--color-white);
    background-color: var(--color-red);

    transition: transform var(--duration-fast) var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .section-hero__cta:hover {
      transform: translateY(-1px);
    }
  }

  .section-hero__cta:focus-visible {
    outline: 1px solid var(--color-white);

    outline-offset: 4px;
  }

  /* ------------------------------
     Tablet
  ------------------------------ */

  @media (min-width: 768px) and (max-width: 1199px) {
    .section-hero__copy {
      grid-column: 1 / span 6;
    }

    .section-hero__title {
      font-size: clamp(3.5rem, 7vw, 5rem);
    }
  }

  /* ------------------------------
     Mobile
  ------------------------------ */

  @media (max-width: 767px) {
    .section-hero,
    .section-hero__content {
      min-height: clamp(485px, 68svh, 610px);
    }

    .section-hero__copy {
      grid-column: 1 / -1;

      padding-bottom: 48px;
    }

    .section-hero__title {
      font-size: clamp(3rem, 13vw, 4.6rem);

      line-height: 0.94;
    }

    .section-hero__cta {
      margin-top: 28px;
    }
  }
</style>
