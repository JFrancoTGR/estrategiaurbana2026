---
import type { CollectionEntry } from 'astro:content';

interface Props {
  zones: CollectionEntry<'zones'>[];
  currentZoneId: string;
}

const { zones, currentZoneId } = Astro.props;
---

<nav class='zone-switcher' aria-label='Explorar zonas'>
  <div class='page-shell'>
    <ul class='zone-switcher__list'>
      {
        zones.map((zone) => {
          const isCurrent = zone.id === currentZoneId;

          return (
            <li class='zone-switcher__item'>
              <a
                href={`/zonas/${zone.id}`}
                class:list={[
                  'zone-switcher__link',
                  {
                    'is-active': isCurrent,
                  },
                ]}
                aria-current={isCurrent ? 'page' : undefined}
              >
                {zone.data.name}
              </a>
            </li>
          );
        })
      }
    </ul>
  </div>
</nav>

<style>
  .zone-switcher {
    width: 100%;
    height: 72px;

    background-color: var(--color-background);

    border-bottom: 1px solid rgb(20 20 20 / 10%);
  }

  .zone-switcher .page-shell {
    height: 100%;
  }

  .zone-switcher__list {
    display: flex;
    align-items: stretch;
    justify-content: flex-end;
    gap: 7px;
    height: 100%;
    margin: 0;
  }

  .zone-switcher__item {
    height: 100%;
  }

  .zone-switcher__link {
    display: flex;
    align-items: center;
    justify-content: center;

    height: 100%;

    padding-inline: clamp(28px, 3vw, 52px);

    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.1em;

    text-transform: uppercase;

    color: var(--color-black);
    background-color: transparent;

    transition:
      color var(--duration-medium) var(--ease-premium),
      background-color var(--duration-medium) var(--ease-premium);
  }

  .zone-switcher__link.is-active {
    color: var(--color-white);
    background-color: var(--color-red);
  }

  @media (hover: hover) and (pointer: fine) {
    .zone-switcher__link:hover {
      color: var(--color-white);
      background-color: var(--color-red);
    }
  }

  .zone-switcher__link:focus-visible {
    color: var(--color-white);
    background-color: var(--color-red);

    outline: 1px solid var(--color-white);
    outline-offset: -3px;
  }

  @media (max-width: 767px) {
    .zone-switcher {
      height: 64px;

      overflow: hidden;
    }

    .zone-switcher .page-shell {
      overflow-x: auto;

      scrollbar-width: none;
    }

    .zone-switcher .page-shell::-webkit-scrollbar {
      display: none;
    }

    .zone-switcher__list {
      width: max-content;

      justify-content: flex-start;
    }

    .zone-switcher__link {
      padding-inline: 28px;

      white-space: nowrap;
    }
  }
</style>
