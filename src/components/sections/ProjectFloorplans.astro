---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface FloorplanItem {
  name: string;
  variant?: string;

  image: {
    image: ImageMetadata;
    alt: string;
  };
}

interface Props {
  index: string;

  title: {
    lead: string;
    emphasis: string;
  };

  items: FloorplanItem[];
}

const { index, title, items } = Astro.props;
---

<section
  id='floorplans'
  class='project-floorplans'
  data-project-floorplans
>
  <div class='project-floorplans__inner'>

    <!-- =========================
         HEADER
    ========================== -->

    <header class='project-floorplans__header'>
      <span class='project-floorplans__index'>
        {index}
      </span>

      <h2 class='project-floorplans__title font-editorial'>
        <span>{title.lead}</span>
        <em>{title.emphasis}</em>
      </h2>
    </header>

    <!-- =========================
         CONTENT
    ========================== -->

    <div class='project-floorplans__layout'>

      <!-- =========================
           SELECTOR
      ========================== -->

      <div
        class='project-floorplans__selector'
        role='tablist'
        aria-label='Tipologías disponibles'
      >
        {
          items.map((item, itemIndex) => (
            <button
              type='button'
              class:list={[
                'project-floorplans__option',
                {
                  'is-active': itemIndex === 0,
                },
              ]}
              role='tab'
              aria-selected={itemIndex === 0 ? 'true' : 'false'}
              data-floorplan-option
              data-floorplan-index={itemIndex}
              data-floorplan-image={item.image.image.src}
              data-floorplan-alt={item.image.alt}
              data-floorplan-title={item.name}
              data-floorplan-variant={item.variant ?? ''}
            >
              <span class='project-floorplans__option-copy'>
                <strong>{item.name}</strong>

                {item.variant && <span>{item.variant}</span>}
              </span>

              <span
                class='project-floorplans__option-arrow'
                aria-hidden='true'
              >
                →
              </span>
            </button>
          ))
        }
      </div>

      <!-- =========================
           DESKTOP / TABLET VIEWER
      ========================== -->

      <div
        class='project-floorplans__viewer'
        aria-live='polite'
      >
        {
          items.map((item, itemIndex) => (
            <figure
              class:list={[
                'project-floorplans__panel',
                {
                  'is-active': itemIndex === 0,
                },
              ]}
              data-floorplan-panel
              data-floorplan-index={itemIndex}
              aria-hidden={itemIndex === 0 ? 'false' : 'true'}
            >
              <Image
                src={item.image.image}
                alt={item.image.alt}
                class='project-floorplans__image'
                loading={itemIndex === 0 ? 'eager' : 'lazy'}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>
</section>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectFloorplans } from '../../scripts/ui/project-floorplans';

  mountPageUI(
    '[data-project-floorplans]',
    initProjectFloorplans,
  );
</script>

<style>
  /* =========================
     SECTION
  ========================= */

  .project-floorplans {
    width: 100%;

    padding-top: clamp(88px, 8vw, 128px);
    padding-bottom: clamp(88px, 8vw, 128px);

    background-color: #deddd9;
  }

  /*
   * Boundary local temporal.
   *
   * Replica visualmente los mismos
   * edges horizontales del header.
   *
   * Se revisará durante el QA final.
   */
  .project-floorplans__inner {
    width: min(
      calc(100% - (var(--page-gutter) * 2)),
      var(--content-max)
    );

    margin-inline: auto;
  }

  /* =========================
     HEADER
  ========================= */

  .project-floorplans__header {
    margin-bottom: clamp(48px, 5vw, 72px);
  }

  .project-floorplans__index {
    display: block;

    margin-bottom: clamp(24px, 2.5vw, 32px);

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.13em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 62%);
  }

  .project-floorplans__title {
    margin: 0;

    font-size: clamp(2rem, 3vw, 3.25rem);
    font-weight: var(--font-weight-light);

    line-height: 1;
    letter-spacing: -0.025em;

    color: var(--color-black);
  }

  .project-floorplans__title span,
  .project-floorplans__title em {
    display: inline;
  }

  .project-floorplans__title em {
    margin-left: 0.15em;

    font-weight: inherit;
    font-style: italic;

    color: var(--color-red);
  }

  /* =========================
     LAYOUT
  ========================= */

  .project-floorplans__layout {
    display: grid;

    grid-template-columns:
      minmax(260px, 4fr)
      minmax(0, 8fr);

    column-gap: var(--grid-gap);

    align-items: start;
  }

  /* =========================
     SELECTOR
  ========================= */

  .project-floorplans__selector {
    display: flex;
    flex-direction: column;

    min-width: 0;

    border-top: 1px solid rgb(20 20 20 / 24%);
  }

  .project-floorplans__option {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 24px;

    width: 100%;

    padding: 24px 16px;

    color: var(--color-black);
    background: transparent;

    border: 0;
    border-bottom: 1px solid rgb(20 20 20 / 24%);

    cursor: pointer;

    text-align: left;
  }

  .project-floorplans__option-copy {
    display: flex;
    flex-direction: column;

    min-width: 0;
  }

  .project-floorplans__option-copy strong {
    font-family: var(--font-primary);
    font-size: clamp(0.95rem, 1vw, 1.0625rem);
    font-weight: var(--font-weight-regular);

    line-height: 1.2;

    color: var(--color-black);
  }

  .project-floorplans__option-copy span {
    margin-top: 7px;

    font-family: var(--font-primary);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.28em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 48%);
  }

  .project-floorplans__option-arrow {
    flex: 0 0 auto;

    font-family: var(--font-primary);
    font-size: 1.1rem;

    opacity: 0.55;

    transition:
      transform 300ms var(--ease-premium),
      opacity 300ms ease;
  }

  .project-floorplans__option.is-active
    .project-floorplans__option-arrow {
    transform: translateX(5px);

    opacity: 1;
  }

  .project-floorplans__option.is-active
    .project-floorplans__option-copy
    strong {
    font-weight: var(--font-weight-medium);
  }

  /* =========================
     VIEWER
  ========================= */

  .project-floorplans__viewer {
    display: grid;

    position: relative;

    min-width: 0;
  }

  /*
   * Todos los paneles comparten la misma
   * celda del grid y permanecen en flujo.
   *
   * El cambio visual se produce únicamente
   * mediante opacity / visibility.
   */
  .project-floorplans__panel {
    grid-area: 1 / 1;

    width: 85%;

    margin: 0 0 0 auto;

    opacity: 0;
    visibility: hidden;

    pointer-events: none;

    transition:
      opacity 380ms var(--ease-premium),
      visibility 0s linear 380ms;
  }

  .project-floorplans__panel.is-active {
    opacity: 1;
    visibility: visible;

    pointer-events: auto;

    transition:
      opacity 380ms var(--ease-premium),
      visibility 0s;
  }

  .project-floorplans__image {
    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;
  }

  /* =========================
     TABLET
  ========================= */

  @media (min-width: 768px) and (max-width: 1199px) {
    .project-floorplans__layout {
      grid-template-columns:
        minmax(220px, 3fr)
        minmax(0, 5fr);

      column-gap: var(--grid-gap);
    }

    .project-floorplans__panel {
      width: 92%;
    }

    .project-floorplans__option {
      padding: 20px 12px;
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-floorplans {
      padding-top: 72px;
      padding-bottom: 80px;
    }

    .project-floorplans__header {
      margin-bottom: 42px;
    }

    .project-floorplans__title {
      font-size: clamp(1.9rem, 8vw, 2.5rem);
    }

    .project-floorplans__title span,
    .project-floorplans__title em {
      display: block;
    }

    .project-floorplans__title em {
      margin-top: 0.08em;
      margin-left: 0;
    }

    .project-floorplans__layout {
      display: block;
    }

    /*
     * En mobile el selector abre GLightbox.
     * No necesitamos mantener el viewer
     * arquitectónico visible.
     */
    .project-floorplans__viewer {
      display: none;
    }

    .project-floorplans__option {
      padding: 22px 8px;
    }
  }

  /* =========================
     REDUCED MOTION
  ========================= */

  @media (prefers-reduced-motion: reduce) {
    .project-floorplans__panel {
      transition: none;
    }
  }
</style>