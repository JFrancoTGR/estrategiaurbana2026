---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface FloorplanItem {
  name: string;
  variant?: string;

  image: {
    image: ImageMetadata;
    alt: string;
  };
}

interface Props {
  index: string;

  title: {
    lead: string;
    emphasis: string;
  };

  items: FloorplanItem[];
}

const { index, title, items } = Astro.props;
---

<section id='floorplans' class='project-floorplans' data-project-floorplans>
  <div class='project-floorplans__inner page-shell'>
    <header class='project-floorplans__header'>
      <span class='project-floorplans__index'>
        {index}
      </span>

      <h2 class='project-floorplans__title font-editorial'>
        <span>{title.lead}</span>
        <em>{title.emphasis}</em>
      </h2>
    </header>

    <div class='project-floorplans__layout'>
      <!-- =========================
           SELECTOR
      ========================== -->

      <div
        class='project-floorplans__selector'
        role='tablist'
        aria-label='Tipologías disponibles'
      >
        {
          items.map((item, itemIndex) => (
            <button
              type='button'
              class:list={[
                'project-floorplans__option',
                {
                  'is-active': itemIndex === 0,
                },
              ]}
              role='tab'
              aria-selected={itemIndex === 0 ? 'true' : 'false'}
              data-floorplan-option
              data-floorplan-index={itemIndex}
            >
              <span class='project-floorplans__option-copy'>
                <strong>{item.name}</strong>

                {item.variant && <span>{item.variant}</span>}
              </span>

              <span class='project-floorplans__option-arrow' aria-hidden='true'>
                →
              </span>
            </button>
          ))
        }
      </div>

      <!-- =========================
           DESKTOP VIEWER
      ========================== -->

      <div class='project-floorplans__viewer' aria-live='polite'>
        {
          items.map((item, itemIndex) => (
            <figure
              class:list={[
                'project-floorplans__panel',
                {
                  'is-active': itemIndex === 0,
                },
              ]}
              data-floorplan-panel
              data-floorplan-index={itemIndex}
              hidden={itemIndex !== 0}
            >
              <Image
                src={item.image.image}
                alt={item.image.alt}
                class='project-floorplans__image'
                loading={itemIndex === 0 ? 'eager' : 'lazy'}
              />
            </figure>
          ))
        }
      </div>
    </div>
  </div>

  <!-- =========================
       MOBILE MODAL
  ========================== -->

  <div
    class='project-floorplans__modal'
    data-floorplan-modal
    aria-hidden='true'
  >
    <button
      type='button'
      class='project-floorplans__backdrop'
      data-floorplan-close
      aria-label='Cerrar tipología'></button>

    <div
      class='project-floorplans__modal-dialog'
      role='dialog'
      aria-modal='true'
      aria-label='Detalle de tipología'
    >
      <button
        type='button'
        class='project-floorplans__modal-close'
        data-floorplan-close
        aria-label='Cerrar'
      >
        ×
      </button>

      {
        items.map((item, itemIndex) => (
          <div
            class:list={[
              'project-floorplans__modal-panel',
              {
                'is-active': itemIndex === 0,
              },
            ]}
            data-floorplan-modal-panel
            data-floorplan-index={itemIndex}
            hidden={itemIndex !== 0}
          >
            <header class='project-floorplans__modal-header'>
              <h3 class='font-editorial'>{item.name}</h3>

              {item.variant && <p>{item.variant}</p>}
            </header>

            <figure class='project-floorplans__modal-figure'>
              <Image
                src={item.image.image}
                alt={item.image.alt}
                class='project-floorplans__modal-image'
                loading='lazy'
              />
            </figure>
          </div>
        ))
      }
    </div>
  </div>
</section>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectFloorplans } from '../../scripts/ui/project-floorplans';

  mountPageUI('[data-project-floorplans]', initProjectFloorplans);
</script>

<style>
  .project-floorplans {
    width: 100%;

    padding-top: clamp(88px, 8vw, 128px);
    padding-bottom: clamp(88px, 8vw, 128px);

    background-color: #deddd9;
  }

  .project-floorplans__inner {
    width: 100%;
  }

  /* =========================
     HEADER
  ========================= */

  .project-floorplans__header {
    margin-bottom: clamp(48px, 5vw, 72px);
  }

  .project-floorplans__index {
    display: block;

    margin-bottom: clamp(24px, 2.5vw, 32px);

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.13em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 62%);
  }

  .project-floorplans__title {
    margin: 0;

    font-size: clamp(2rem, 3vw, 3.25rem);
    font-weight: var(--font-weight-light);

    line-height: 1;
    letter-spacing: -0.025em;

    color: var(--color-black);
  }

  .project-floorplans__title span,
  .project-floorplans__title em {
    display: inline;
  }

  .project-floorplans__title em {
    margin-left: 0.15em;

    font-weight: inherit;
    font-style: italic;

    color: var(--color-red);
  }

  /* =========================
     LAYOUT
  ========================= */

  .project-floorplans__layout {
    display: grid;

    grid-template-columns:
      minmax(250px, 0.36fr)
      minmax(0, 0.64fr);

    align-items: start;

    gap: clamp(48px, 5vw, 82px);
  }

  /* =========================
     SELECTOR
  ========================= */

  .project-floorplans__selector {
    display: flex;
    flex-direction: column;

    min-width: 0;

    border-top: 1px solid rgb(20 20 20 / 24%);
  }

  .project-floorplans__option {
    display: flex;

    align-items: center;
    justify-content: space-between;

    gap: 24px;

    width: 100%;

    padding: 24px 16px;

    color: var(--color-black);
    background: transparent;

    border: 0;
    border-bottom: 1px solid rgb(20 20 20 / 24%);

    cursor: pointer;

    text-align: left;
  }

  .project-floorplans__option-copy {
    display: flex;
    flex-direction: column;

    min-width: 0;
  }

  .project-floorplans__option-copy strong {
    font-family: var(--font-primary);
    font-size: clamp(0.95rem, 1vw, 1.0625rem);
    font-weight: var(--font-weight-regular);

    line-height: 1.2;

    color: var(--color-black);
  }

  .project-floorplans__option-copy span {
    margin-top: 7px;

    font-family: var(--font-primary);
    font-size: 0.5625rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.28em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 48%);
  }

  .project-floorplans__option-arrow {
    flex: 0 0 auto;

    font-family: var(--font-primary);
    font-size: 1.1rem;

    transition:
      transform 300ms var(--ease-premium),
      opacity 300ms ease;

    opacity: 0.55;
  }

  .project-floorplans__option.is-active .project-floorplans__option-arrow {
    transform: translateX(5px);

    opacity: 1;
  }

  .project-floorplans__option.is-active
    .project-floorplans__option-copy
    strong {
    font-weight: var(--font-weight-medium);
  }

  /* =========================
     VIEWER
  ========================= */

  .project-floorplans__viewer {
    position: relative;

    min-width: 0;
  }

  .project-floorplans__panel {
    width: 100%;

    margin: 0;
  }

  .project-floorplans__panel[hidden] {
    display: none;
  }

  .project-floorplans__image {
    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;
  }

  /* =========================
     MODAL
  ========================= */

  .project-floorplans__modal {
    position: fixed;
    z-index: 1000;

    inset: 0;

    display: none;

    align-items: stretch;
    justify-content: center;
  }

  .project-floorplans__modal.is-open {
    display: flex;
  }

  .project-floorplans__backdrop {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    padding: 0;

    background: rgb(0 0 0 / 55%);

    border: 0;
  }

  .project-floorplans__modal-dialog {
    position: relative;
    z-index: 1;

    width: min(100%, 760px);
    height: 100%;

    margin-left: auto;

    overflow-y: auto;

    background-color: #fff;
  }

  .project-floorplans__modal-close {
    position: sticky;
    z-index: 3;

    top: 18px;

    display: flex;

    align-items: center;
    justify-content: center;

    width: 42px;
    height: 42px;

    margin: 18px 18px 0 auto;

    padding: 0;

    font-family: var(--font-primary);
    font-size: 1.75rem;
    font-weight: var(--font-weight-light);

    line-height: 1;

    color: var(--color-black);
    background-color: rgb(255 255 255 / 90%);

    border: 1px solid rgb(20 20 20 / 14%);
    border-radius: 50%;

    cursor: pointer;
  }

  .project-floorplans__modal-panel {
    padding: 18px clamp(24px, 6vw, 48px) 56px;
  }

  .project-floorplans__modal-panel[hidden] {
    display: none;
  }

  .project-floorplans__modal-header {
    margin-bottom: 32px;
  }

  .project-floorplans__modal-header h3 {
    margin: 0;

    font-size: clamp(2rem, 8vw, 3rem);
    font-weight: var(--font-weight-light);

    line-height: 1;

    color: var(--color-black);
  }

  .project-floorplans__modal-header p {
    margin: 10px 0 0;

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.24em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 52%);
  }

  .project-floorplans__modal-figure {
    width: 100%;

    margin: 0;
  }

  .project-floorplans__modal-image {
    display: block;

    width: 100%;
    height: auto;

    object-fit: contain;
  }

  /* =========================
     TABLET
  ========================= */

  @media (min-width: 768px) and (max-width: 1199px) {
    .project-floorplans__layout {
      grid-template-columns:
        minmax(220px, 0.34fr)
        minmax(0, 0.66fr);

      gap: 42px;
    }

    .project-floorplans__option {
      padding: 20px 12px;
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-floorplans {
      padding-top: 72px;
      padding-bottom: 80px;
    }

    .project-floorplans__header {
      margin-bottom: 42px;
    }

    .project-floorplans__title {
      font-size: clamp(1.9rem, 8vw, 2.5rem);
    }

    .project-floorplans__title span,
    .project-floorplans__title em {
      display: block;
    }

    .project-floorplans__title em {
      margin-top: 0.08em;
      margin-left: 0;
    }

    .project-floorplans__layout {
      display: block;
    }

    .project-floorplans__viewer {
      display: none;
    }

    .project-floorplans__option {
      padding: 22px 8px;
    }
  }
</style>
