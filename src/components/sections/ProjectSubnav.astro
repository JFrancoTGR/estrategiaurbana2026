---
const navigation = [
  {
    label: 'Proyecto',
    href: '#project',
  },
  {
    label: 'Ubicación',
    href: '#location',
  },
  {
    label: 'Amenidades',
    href: '#features',
  },
  {
    label: 'Tipologías',
    href: '#typologies',
  },
  {
    label: 'Galería',
    href: '#gallery',
  },
];
---

<nav
  class='project-subnav'
  aria-label='Navegación del proyecto'
  data-project-subnav
>
  <div class='page-shell'>
    <ul class='project-subnav__list'>
      {
        navigation.map((item, index) => (
          <li class='project-subnav__item'>
            <a
              href={item.href}
              class:list={[
                'project-subnav__link',
                {
                  'is-active': index === 0,
                },
              ]}
              data-project-subnav-link
            >
              {item.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</nav>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectSubnav } from '../../scripts/ui/project-subnav';

  mountPageUI('[data-project-subnav]', initProjectSubnav);
</script>

<style>
  .project-subnav {
    --project-subnav-bg: var(--color-black);
    --project-subnav-text: rgb(240 240 240 / 58%);
    --project-subnav-text-active: var(--color-white);
    --project-subnav-accent: var(--color-red);
    --project-subnav-border: rgb(240 240 240 / 10%);

    position: relative;
    z-index: 900;

    width: 100%;
    height: 72px;

    background-color: var(--project-subnav-bg);

    border-bottom: 1px solid var(--project-subnav-border);
  }

  .project-subnav .page-shell {
    height: 100%;
  }

  /* =========================
     LIST
  ========================= */

  .project-subnav__list {
    display: flex;
    align-items: stretch;
    justify-content: flex-start;

    gap: 7px;

    height: 100%;
    margin: 0;
  }

  .project-subnav__item {
    height: 100%;
  }

  /* =========================
     LINKS
  ========================= */

  .project-subnav__link {
    position: relative;

    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    height: 100%;

    padding-inline: clamp(28px, 3vw, 52px);

    font-family: var(--font-primary);

    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.1em;

    text-transform: uppercase;

    color: var(--project-subnav-text);
    background-color: transparent;

    transition: color var(--duration-fast) var(--ease-premium);
  }

  /*
   * Franja inferior.
   *
   * Ocupa la caja completa del enlace, pero permanece
   * colapsada sobre el borde inferior.
   *
   * Al activarse crece verticalmente desde abajo,
   * sin modificar las dimensiones ni las métricas
   * del texto.
  */

  .project-subnav__link::before {
    content: '';

    position: absolute;
    z-index: -1;

    inset: 0;

    background-color: var(--project-subnav-accent);

    transform: scaleY(0);
    transform-origin: bottom;

    transition: transform 200ms var(--ease-premium);

    pointer-events: none;
  }

  /* =========================
     ACTIVE
  ========================= */

  .project-subnav__link.is-active {
    color: var(--project-subnav-text-active);
  }

  .project-subnav__link.is-active::before {
    transform: scaleY(0.06);
  }

  /* =========================
     HOVER
  ========================= */

  @media (hover: hover) and (pointer: fine) {
    .project-subnav__link:hover {
      color: var(--project-subnav-text-active);
    }

    .project-subnav__link:hover::before {
      transform: scaleY(0.06);
    }
  }

  /* =========================
     ACCESSIBILITY
  ========================= */

  .project-subnav__link:focus-visible {
    color: var(--project-subnav-text-active);

    outline: 1px solid var(--color-white);
    outline-offset: -3px;
  }

  .project-subnav__link:focus-visible::before {
    transform: scaleY(0.06);
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-subnav {
      height: 64px;

      overflow: hidden;
    }

    .project-subnav .page-shell {
      height: 100%;

      overflow-x: auto;
      overflow-y: hidden;

      scrollbar-width: none;

      -webkit-overflow-scrolling: touch;

      overscroll-behavior-x: contain;
    }

    .project-subnav .page-shell::-webkit-scrollbar {
      display: none;
    }

    .project-subnav__list {
      width: max-content;
      min-width: 100%;

      justify-content: flex-start;
      flex-wrap: nowrap;
    }

    .project-subnav__item {
      flex: 0 0 auto;
    }

    .project-subnav__link {
      padding-inline: 28px;

      white-space: nowrap;
    }

    .project-subnav::after {
      content: '›';

      position: absolute;
      z-index: 5;

      top: 0;
      right: 0;

      display: flex;
      align-items: center;
      justify-content: center;

      width: 48px;
      height: 100%;

      font-family: var(--font-primary);
      font-size: 1.35rem;
      font-weight: var(--font-weight-regular);

      line-height: 1;

      color: rgb(240 240 240 / 72%);

      background: linear-gradient(
        to right,
        rgb(20 20 20 / 0%),
        var(--color-black) 35%,
        var(--color-black) 100%
      );

      opacity: 0;

      pointer-events: none;

      transition: opacity var(--duration-fast) var(--ease-premium);
    }

    .project-subnav[data-can-scroll-right='true']::after {
      opacity: 1;
    }
  }

  /* =========================
     REDUCED MOTION
  ========================= */

  @media (prefers-reduced-motion: reduce) {
    .project-subnav__link,
    .project-subnav__link::before {
      transition: none;
    }
  }
</style>
