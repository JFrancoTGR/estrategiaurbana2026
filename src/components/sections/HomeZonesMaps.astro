---
import 'leaflet/dist/leaflet.css';
---

<section class='home-zones-map'>
  <div
    class='home-zones-map__canvas'
    data-zones-map
    aria-label='Mapa de Ciudad de México'
  >
  </div>
</section>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initZonesMap } from '../../scripts/ui/zones-map';

  mountPageUI('[data-zones-map]', initZonesMap);
</script>

<style>
  .home-zones-map {
    width: 100%;

    background-color: var(--color-background);
  }

  .home-zones-map__canvas {
    width: 100%;
    height: clamp(520px, 65vh, 760px);
  }

  :global(.leaflet-container) {
    font-family: var(--font-primary);

    background-color: var(--color-surface-muted);
  }

  @media (max-width: 767px) {
    .home-zones-map__canvas {
      height: 520px;
    }
  }
</style>
