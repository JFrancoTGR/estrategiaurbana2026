---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  subtitle: string;
}

const { image, alt, title, subtitle } = Astro.props;
---

<section class='zone-hero'>
  <Image
    src={image}
    alt={alt}
    class='zone-hero__image'
    loading='eager'
    fetchpriority='high'
  />

  <div class='zone-hero__content page-shell'>
    <p class='zone-hero__subtitle'>
      {subtitle}
    </p>

    <h1 class='zone-hero__title font-editorial'>
      {title}
    </h1>
  </div>
</section>

<style>
  .zone-hero {
    position: relative;
    isolation: isolate;

    width: 100%;
    min-height: clamp(620px, 78svh, 860px);

    overflow: hidden;

    color: var(--color-white);
    background-color: var(--color-black);
  }

  .zone-hero__image {
    position: absolute;
    z-index: -2;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  .zone-hero::after {
    content: '';

    position: absolute;
    z-index: -1;
    inset: 0;

    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 39%) 0%,
      rgb(0 0 0 / 25%) 38%,
      rgb(0 0 0 / 28%) 100%
    );
  }

  .zone-hero__content {
    min-height: clamp(620px, 78svh, 860px);

    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;

    padding-top: var(--header-height);

    text-align: center;
  }

  .zone-hero__subtitle {
    margin: 0 0 18px;

    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.14em;
    text-transform: uppercase;
  }

  .zone-hero__title {
    max-width: 1100px;

    margin: 0;

    font-size: clamp(4rem, 7vw, 8rem);
    font-weight: var(--font-weight-regular);

    line-height: 0.92;
    letter-spacing: -0.045em;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 45%),
      0 4px 18px rgb(0 0 0 / 25%);
  }

  @media (max-width: 767px) {
    .zone-hero,
    .zone-hero__content {
      min-height: clamp(540px, 72svh, 680px);
    }

    .zone-hero__title {
      font-size: clamp(3rem, 13vw, 5rem);
    }
  }
</style>
