---
import { getCollection } from 'astro:content';

import PartnerProfileCard from '../cards/PartnerProfileCard.astro';

const partners = (await getCollection('partners')).sort(
  (a, b) => a.data.order - b.data.order,
);
---

<section class='partners-grid' data-motion='partners-grid'>
  <div class='page-shell'>
    <div class='partners-grid__list'>
      {
        partners.map((partner) => (
          <div class='partners-grid__item' data-partner-card>
            <PartnerProfileCard partner={partner} />
          </div>
        ))
      }
    </div>
  </div>
</section>

<style>
  .partners-grid {
    width: 100%;

    padding-top: calc(var(--header-height) + clamp(36px, 4vw, 64px));

    padding-bottom: clamp(56px, 5vw, 80px);

    background-color: var(--color-background);
  }

  .partners-grid__list {
    display: grid;

    grid-template-columns: repeat(2, minmax(0, 1fr));

    gap: clamp(8px, 0.8vw, 14px);
  }

  .partners-grid__item {
    min-width: 0;
  }

  @media (max-width: 1024px) {
    .partners-grid__list {
      grid-template-columns: 1fr;

      gap: 14px;
    }
  }

  @media (max-width: 767px) {
    .partners-grid {
      padding-top: calc(var(--header-height-scrolled) + 28px);

      padding-bottom: 72px;
    }
  }
</style>
