---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  mark: ImageMetadata;
}

const { image, mark } = Astro.props;
---

<section class='home-hero'>
  <Image
    src={image}
    alt=''
    class='home-hero__image'
    loading='eager'
    fetchpriority='high'
  />

  <div class='home-hero__content page-shell layout-grid'>
    <div class='home-hero__copy'>
      <img src={mark.src} alt='' class='home-hero__mark' aria-hidden='true' />

      <h1 class='home-hero__title font-editorial'>
        <span>Valor inmobiliario desarrollado</span>
        <span>con criterio.</span>
      </h1>

      <p class='home-hero__description'>
        Estrategia Urbana es una desarrolladora inmobiliaria impulsada por el
        diseño, la tecnología, los procesos y la confianza. Nuestros proyectos
        se construyen con una visión clara: el valor debe planearse, diseñarse,
        construirse y entregarse.
      </p>

      <a href='/contacto' class='home-hero__cta'> Agenda una cita </a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;

    width: 100%;
    min-height: 100svh;

    overflow: hidden;

    color: var(--color-white);
    background-color: var(--color-black);
  }

  .home-hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  /* Support for header readability */
  .home-hero::after {
    content: '';

    position: absolute;
    z-index: 1;
    inset: 0 0 auto;

    width: 100%;
    height: 220px;

    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 21%) 0%,
      rgb(0 0 0 / 13%) 45%,
      rgb(0 0 0 / 7%) 72%,
      transparent 100%
    );

    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
    z-index: 2;

    min-height: 100svh;

    align-items: end;
  }

  .home-hero__copy {
    grid-column: 1 / span 6;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    padding-bottom: clamp(76px, 8vw, 126px);
  }

  .home-hero__mark {
    display: block;

    width: auto;
    height: clamp(69px, 6.4vw, 136px);

    margin-bottom: 24px;
  }

  .home-hero__title {
    font-size: clamp(1.8rem, 3.1vw, 4.3rem);
    font-weight: var(--font-weight-light);
    line-height: 0.95;
    letter-spacing: -0.035em;
  }

  .home-hero__title span {
    display: block;
  }

  .home-hero__description {
    max-width: 640px;

    margin-top: 28px;

    font-family: var(--font-primary);
    font-size: 1rem;
    font-weight: var(--font-weight-regular);
    line-height: 1.6;
  }

  .home-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 32px;
    padding: 14px 24px;

    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: var(--color-white);
    background-color: var(--color-red);

    transition:
      background-color var(--duration-fast) var(--ease-premium),
      transform var(--duration-fast) var(--ease-premium);
  }

  .home-hero__cta:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 1199px) {
    .home-hero__copy {
      grid-column: 1 / span 6;
    }
  }

  @media (max-width: 767px) {
    .home-hero__copy {
      grid-column: 1 / -1;

      padding-bottom: 48px;
    }

    .home-hero__title {
      font-size: clamp(3rem, 13vw, 5rem);
    }

    .home-hero__description {
      max-width: 100%;
    }
  }
</style>
