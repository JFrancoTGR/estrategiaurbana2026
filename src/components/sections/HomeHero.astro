---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

import { withBase } from '../../utils/paths';

interface Props {
  image: ImageMetadata;
  mark: ImageMetadata;
}

const { image, mark } = Astro.props;
---

<section id='home-hero' class='home-hero' data-motion='home-hero'>
  <Image
    src={image}
    alt=''
    class='home-hero__image'
    loading='eager'
    fetchpriority='high'
    data-anim='media'
  />

  <div class='home-hero__content page-shell layout-grid'>
    <div class='home-hero__copy'>
      <img
        src={mark.src}
        alt=''
        class='home-hero__mark'
        aria-hidden='true'
        data-anim='mark'
      />

      <h1 class='home-hero__title font-editorial' data-anim='title'>
        <span>Valor inmobiliario desarrollado</span>
        <span>con criterio.</span>
      </h1>

      <p class='home-hero__description' data-anim='description'>
        Estrategia Urbana desarrolla proyectos inmobiliarios pensados para
        responder a nuevas formas de vivir, invertir y relacionarse con la
        ciudad. Nuestros proyectos se construyen con una visión clara: el valor
        debe planearse, diseñarse, construirse y entregarse.”
      </p>

      <a
        href='#contacto'
        class='home-hero__cta'
        data-anim='cta'
        data-home-contact-cta
      >
        Contáctanos
      </a>
    </div>
  </div>
</section>

<style>
  .home-hero {
    position: relative;

    width: 100%;
    min-height: 100svh;

    overflow: hidden;

    color: var(--color-white);
    background-color: var(--color-black);
  }

  .home-hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  /* Support for header readability */
  .home-hero::after {
    content: '';

    position: absolute;
    z-index: 1;
    inset: 0;

    background: linear-gradient(
      to bottom,
      rgb(0 0 0 / 7%) 0%,
      rgb(0 0 0 / 23%) 45%,
      rgb(0 0 0 / 48%) 100%,
      transparent 100%
    );

    pointer-events: none;
  }

  .home-hero__content {
    position: relative;
    z-index: 2;

    min-height: 100svh;

    align-items: end;
  }

  .home-hero__copy {
    grid-column: 1 / span 6;

    display: flex;
    flex-direction: column;
    align-items: flex-start;

    padding-bottom: clamp(76px, 8vw, 126px);
  }

  .home-hero__mark {
    display: block;

    width: auto;
    height: clamp(86px, 7.4vw, 176px);

    margin-bottom: 54px;
  }

  .home-hero__title {
    font-size: clamp(1.3rem, 2.6vw, 3.4rem);
    font-weight: var(--font-weight-regular);
    line-height: 0.95;
    letter-spacing: -0.035em;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 76%),
      0 2px 12px rgb(0 0 0 / 76%);

    transition: text-shadow var(--duration-fast) var(--ease-premium);
  }

  .home-hero__title span {
    display: block;
  }

  .home-hero__description {
    max-width: 640px;

    margin-top: 28px;

    font-family: var(--font-primary);
    font-size: 1.4rem;
    font-weight: var(--font-weight-regular);
    line-height: 1.6;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 86%),
      0 2px 12px rgb(0 0 0 / 86%);

    transition: text-shadow var(--duration-fast) var(--ease-premium);
  }

  .home-hero__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    margin-top: 32px;
    padding: 14px 24px;

    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: var(--color-white);
    background-color: var(--color-red);

    transition:
      background-color var(--duration-fast) var(--ease-premium),
      transform var(--duration-fast) var(--ease-premium);
  }

  .home-hero__cta:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 1199px) {
    .home-hero__copy {
      grid-column: 1 / span 6;
    }
  }

  @media (max-width: 767px) {
    .home-hero__copy {
      grid-column: 1 / -1;

      padding-bottom: 48px;
    }

    .home-hero__title {
      font-size: clamp(2.5rem, 10vw, 4rem);
    }

    .home-hero__description {
      max-width: 100%;

      font-size: clamp(1rem, 3.5vw, 1.125rem);
      line-height: 1.45;

      margin-top: 22px;
    }
  }

  /* ---------------------------------
   Short desktop viewports
--------------------------------- */

  @media (min-width: 768px) and (max-height: 800px) {
    .home-hero__content {
      min-height: 100svh;
    }

    .home-hero__copy {
      padding-top: calc(var(--header-height) + 32px);
      padding-bottom: clamp(32px, 5vh, 60px);
    }

    .home-hero__mark {
      display: none;
    }

    .home-hero__title {
      font-size: clamp(1.5rem, 2.2vw, 2.5rem);
      line-height: 1.05;
    }

    .home-hero__description {
      max-width: 580px;

      margin-top: 20px;

      font-size: clamp(0.95rem, 1.2vw, 1.15rem);
      line-height: 1.45;
    }

    .home-hero__cta {
      margin-top: 24px;
    }
  }

  /* =========================
   TOUCH LANDSCAPE
  ========================= */

  @media (orientation: landscape) and (any-pointer: coarse) {
    .home-hero__mark {
      display: none;
    }
  }
</style>
