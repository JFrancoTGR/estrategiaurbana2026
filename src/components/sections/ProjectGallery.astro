---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type GalleryVariant = 'standard' | 'wide' | 'tall' | 'feature';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
  variant?: GalleryVariant;
}

interface Props {
  index: string;

  title: {
    lead: string;
    emphasis: string;
  };

  note?: {
    lead: string;
    action: string;
  };

  items: GalleryItem[];
}

const { index, title, note, items } = Astro.props;
---

<section
  id='gallery'
  class='project-gallery'
  data-project-gallery
  data-motion='project-gallery'
>
  <div class='project-gallery__inner'>
    <!-- =========================
         HEADER
    ========================== -->

    <header class='project-gallery__header'>
      <div class='project-gallery__heading'>
        <span class='project-gallery__index' data-anim>
          {index}
        </span>

        <h2 class='project-gallery__title font-editorial' data-anim>
          <span>{title.lead}</span>
          <em>{title.emphasis}</em>
        </h2>
      </div>

      {
        note && (
          <div class='project-gallery__note' data-anim>
            <span>{note.lead}</span>
            <small>{note.action}</small>
          </div>
        )
      }
    </header>

    <div class='project-gallery__divider' aria-hidden='true' data-anim></div>

    <!-- =========================
         GALLERY
    ========================== -->

    <div class='project-gallery__grid' data-project-gallery-grid>
      {
        items.map((item, itemIndex) => {
          const variant = item.variant ?? 'standard';

          return (
            <button
              type='button'
              class:list={[
                'project-gallery__item',
                `project-gallery__item--${variant}`,
              ]}
              data-project-gallery-trigger
              data-gallery-index={itemIndex}
              data-gallery-image={item.image.src}
              data-gallery-alt={item.alt}
              aria-label={`Ampliar imagen: ${item.alt}`}
            >
              <Image
                src={item.image}
                alt={item.alt}
                class='project-gallery__image'
                loading='lazy'
              />
            </button>
          );
        })
      }
    </div>
  </div>
</section>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectGallery } from '../../scripts/ui/project-gallery';

  mountPageUI('[data-project-gallery]', initProjectGallery);
</script>

<style>
  /* =========================
     SECTION
  ========================= */

  .project-gallery {
    width: 100%;

    padding-top: clamp(88px, 8vw, 128px);
    padding-bottom: clamp(96px, 9vw, 144px);

    background-color: var(--color-background);
  }

  .project-gallery__inner {
    width: min(calc(100% - (var(--page-gutter) * 2)), var(--content-max));

    margin-inline: auto;
  }

  /* =========================
     HEADER
  ========================= */

  .project-gallery__header {
    display: grid;

    grid-template-columns:
      minmax(0, 1fr)
      auto;

    align-items: end;

    column-gap: clamp(40px, 6vw, 96px);
  }

  .project-gallery__heading {
    min-width: 0;
  }

  .project-gallery__index {
    display: block;

    margin-bottom: clamp(18px, 2vw, 26px);

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.13em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 62%);
  }

  .project-gallery__title {
    margin: 0;

    font-size: clamp(2.25rem, 3.4vw, 3.75rem);
    font-weight: var(--font-weight-light);

    line-height: 0.9;
    letter-spacing: -0.03em;

    color: var(--color-black);
  }

  .project-gallery__title span,
  .project-gallery__title em {
    display: block;
  }

  .project-gallery__title em {
    margin-top: 0.08em;

    font-weight: inherit;
    font-style: normal;

    color: var(--color-red);
  }

  /* =========================
     NOTE
  ========================= */

  .project-gallery__note {
    display: flex;
    flex-direction: column;

    align-items: flex-start;

    padding-bottom: 4px;

    font-family: var(--font-primary);
    font-weight: var(--font-weight-medium);

    line-height: 1.35;
    letter-spacing: 0.22em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 58%);
  }

  .project-gallery__note span {
    font-size: 0.625rem;
  }

  .project-gallery__note small {
    margin-top: 3px;

    font-size: 0.5625rem;
    font-weight: inherit;
  }

  /* =========================
     DIVIDER
  ========================= */

  .project-gallery__divider {
    width: 100%;
    height: 1px;

    margin-top: clamp(32px, 3.5vw, 48px);
    margin-bottom: clamp(40px, 4vw, 58px);

    background-color: rgb(20 20 20 / 20%);
  }

  /* =========================
     DESKTOP GRID
  ========================= */

  .project-gallery__grid {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    grid-auto-flow: dense;

    grid-auto-rows: clamp(180px, 17vw, 290px);

    gap: clamp(8px, 1vw, 14px);
  }

  .project-gallery__item--standard {
    grid-column: span 1;
    grid-row: span 1;
  }

  .project-gallery__item--wide {
    grid-column: span 2;
    grid-row: span 1;
  }

  .project-gallery__item--tall {
    grid-column: span 1;
    grid-row: span 2;
  }

  .project-gallery__item--feature {
    grid-column: span 2;
    grid-row: span 2;
  }

  /* =========================
     ITEM
  ========================= */

  .project-gallery__item {
    position: relative;

    min-width: 0;
    min-height: 0;

    overflow: hidden;

    padding: 0;

    background-color: var(--color-surface-muted);

    border: 0;

    cursor: zoom-in;
  }

  .project-gallery__image {
    display: block;

    width: 100%;
    height: 100%;

    object-fit: cover;

    transform: scale(1);

    transition:
      transform 600ms var(--ease-premium),
      opacity 300ms ease;
  }

  /* =========================
     INTERACTION
  ========================= */

  @media (hover: hover) and (pointer: fine) {
    .project-gallery__item:hover .project-gallery__image {
      transform: scale(1.025);
    }
  }

  .project-gallery__item:focus-visible {
    outline: 1px solid var(--color-black);

    outline-offset: 4px;
  }

  /* =========================
   ANIMATION
  ========================= */

  .project-gallery [data-anim] {
    opacity: 0;
    transform: translateY(12px);

    transition:
      opacity 700ms var(--ease-premium),
      transform 700ms var(--ease-premium);
  }

  .project-gallery [data-anim].is-visible {
    opacity: 1;
    transform: translateY(0);
  }

  .project-gallery__title[data-anim] {
    transition-delay: 100ms;
  }

  .project-gallery__note[data-anim] {
    transition-delay: 100ms;
  }

  .project-gallery__divider[data-anim] {
    transition-delay: 180ms;
  }

  /* =========================
   TABLET
  ========================= */

  @media (min-width: 768px) and (max-width: 1199px) {
    .project-gallery__grid {
      display: flex;

      width: auto;

      overflow-x: auto;
      overflow-y: hidden;

      gap: clamp(10px, 1.4vw, 16px);

      padding-bottom: 4px;

      scroll-snap-type: x mandatory;
      scroll-padding-left: 0;

      overscroll-behavior-x: contain;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;
    }

    .project-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .project-gallery__item,
    .project-gallery__item--standard,
    .project-gallery__item--wide,
    .project-gallery__item--tall,
    .project-gallery__item--feature {
      flex: 0 0 calc(50% - clamp(5px, 0.7vw, 8px));

      grid-column: auto;
      grid-row: auto;

      aspect-ratio: 2 / 3;

      scroll-snap-align: start;
      scroll-snap-stop: normal;
    }

    .project-gallery__image {
      width: 100%;
      height: 100%;

      object-fit: cover;
    }
  }

  /* =========================
   MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-gallery {
      padding-top: 72px;
      padding-bottom: 80px;

      overflow: hidden;
    }

    .project-gallery__header {
      grid-template-columns: 1fr;

      row-gap: 28px;
    }

    .project-gallery__title {
      font-size: clamp(2.25rem, 11vw, 3rem);
    }

    .project-gallery__note {
      padding-bottom: 0;
    }

    .project-gallery__divider {
      margin-top: 30px;
      margin-bottom: 32px;
    }

    .project-gallery__grid {
      display: flex;

      width: auto;

      overflow-x: auto;
      overflow-y: hidden;

      gap: 12px;

      padding-right: var(--page-gutter);
      padding-bottom: 4px;

      scroll-snap-type: x mandatory;
      scroll-padding-left: 0;

      overscroll-behavior-x: contain;

      -webkit-overflow-scrolling: touch;

      scrollbar-width: none;
    }

    .project-gallery__grid::-webkit-scrollbar {
      display: none;
    }

    .project-gallery__item,
    .project-gallery__item--standard,
    .project-gallery__item--wide,
    .project-gallery__item--tall,
    .project-gallery__item--feature {
      /*
     * Una imagen dominante +
     * pequeña pista de la siguiente.
     */
      flex: 0 0 86%;

      grid-column: auto;
      grid-row: auto;

      aspect-ratio: 2 / 3;

      scroll-snap-align: start;
      scroll-snap-stop: normal;
    }

    .project-gallery__image {
      width: 100%;
      height: 100%;

      object-fit: cover;
    }
  }

  /* =========================
     REDUCED MOTION
  ========================= */

  @media (prefers-reduced-motion: reduce) {
    .project-gallery [data-anim] {
      opacity: 1;
      transform: none;
      transition: none;
    }

    .project-gallery__image {
      transition: none;
    }

    .project-gallery__grid {
      scroll-behavior: auto;
    }
  }
</style>
