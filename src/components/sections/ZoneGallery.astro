--- import {
  Image
}

from 'astro:assets';

import type {
  ImageMetadata
}

from 'astro';

import 'swiper/css';
import 'swiper/css/pagination';

interface GalleryItem {
  image: ImageMetadata;
  alt: string;
}

interface Props {
  gallery: GalleryItem[];
}

const {
  gallery
}

=Astro.props;

const hasSlider=gallery.length>1;

--- <section class='zone-gallery'data-zone-gallery> {
  hasSlider ? (<div class='swiper zone-gallery__slider'data-zone-gallery-slider> <div class='swiper-wrapper'> {
      gallery.map((item)=> (<div class='swiper-slide zone-gallery__slide'> <Image src= {
            item.image
          }

          alt= {
            item.alt
          }

          class='zone-gallery__image'loading='lazy'/> </div>))
    }

    </div> </div> <div class='zone-gallery__pagination'data-zone-gallery-pagination></div>) : (<div class='zone-gallery__single page-shell'> <Image src= {
      gallery[0].image
    }

    alt= {
      gallery[0].alt
    }

    class='zone-gallery__imageImaoading='lazy' />
</div>)
}

</section><script>import {
  mountPageUI
}

from '../../scripts/ui/page-lifecycle';

import {
  initZoneGallery
}

from '../../scripts/ui/zone-gallery';

mountPageUI('[data-zone-gallery]', initZoneGallery);

</script><style>.zone-gallery {
  width: 100%;

  padding-block: clamp(84px, 9vw, 140px);

  overflow: hidden;

  background-color: var(--color-background);
}

.zone-gallery__slider {
  width: 100%;

  overflow: visible;
}

.zone-gallery__slide {
  width: min(64vw, 980px);
}

.zone-gallery__image {
  display: block;

  width: 100%;
  aspect-ratio: 16 / 10;

  object-fit: cover;
}

.zone-gallery__single {
  max-width: 1100px;
}

.zone-gallery__pagination {
  display: flex;
  align-items: center;
  justify-content: center;

  gap: 10px;

  margin-top: clamp(28px, 3vw, 40px);
}

.zone-gallery__pagination :global(.swiper-pagination-bullet) {
  width: 7px;
  height: 7px;

  margin: 0 !important;

  border-radius: 50%;

  opacity: 1;

  background-color: rgb(20 20 20 / 20%);

  transition:
    transform var(--duration-fast) var(--ease-premium),
    background-color var(--duration-fast) var(--ease-premium);
}

.zone-gallery__pagination :global(.swiper-pagination-bullet-active) {
  transform: scale(1.25);

  background-color: var(--color-red);
}

@media (prefers-reduced-motion: reduce) {
  .zone-gallery__pagination :global(.swiper-pagination-bullet) {
    transition: none;
  }
}

@media (max-width: 767px) {
  .zone-gallery {
    padding-block: 72px;
  }

  .zone-gallery__slide {
    width: 86vw;
  }

  .zone-gallery__image {
    aspect-ratio: 4 / 3;
  }
}

</style>