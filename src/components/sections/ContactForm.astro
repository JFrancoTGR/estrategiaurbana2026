---
import { getCollection } from 'astro:content';

interface Props {
  projectInterest?: string;
  conversionSource?: string;
}

const { projectInterest = '', conversionSource = 'home_contact_form' } =
  Astro.props;

// Deben coincidir con las etiquetas comerciales usadas en GHL.
const normalizeProject = (value: string) =>
  value
    .normalize('NFD')
    .replace(/[\u0300-\u036f]/g, '')
    .trim()
    .replace(/\s+/g, ' ')
    .toUpperCase();

const projects = (
  await getCollection('projects', ({ data }) => data.commercial.available)
)
  .map(({ data }) => ({
    label: data.name.toLocaleUpperCase('es-MX'),
    value: normalizeProject(data.name),
  }))
  .sort((a, b) => a.label.localeCompare(b.label, 'es'));

const selectedProject = projectInterest
  ? normalizeProject(projectInterest)
  : 'CONSULTA GENERAL';

if (
  projectInterest &&
  !projects.some((project) => project.value === selectedProject)
) {
  projects.unshift({
    label: projectInterest.toLocaleUpperCase('es-MX'),
    value: selectedProject,
  });
}
---

<section id='contacto' class='contact-form'>
  <div class='page-shell contact-form__layout'>
    <div class='contact-form__intro'>
      <p class='contact-form__eyebrow'>CONTÁCTANOS</p>

      <h2 class='contact-form__title font-editorial'>
        Empecemos la
        <strong>conversación</strong>
        <strong>correcta.</strong>
      </h2>

      <p class='contact-form__description'>
        Ya sea que estés interesado en uno de nuestros proyectos, explorando una
        oportunidad de inversión, buscando desarrollar una propiedad o
        construyendo una alianza estratégica, queremos escucharte.
      </p>
    </div>

    <form
      class='contact-form__form'
      data-eu-contact-form
      data-conversion-source={conversionSource}
      aria-label='Formulario de contacto'
      method='post'
      novalidate
    >
      <div class='contact-form__row'>
        <div class='contact-form__field'>
          <label for='contact-first-name'>NOMBRE *</label>
          <input
            id='contact-first-name'
            name='first_name'
            type='text'
            autocomplete='given-name'
            minlength='2'
            maxlength='70'
            required
          />
        </div>

        <div class='contact-form__field'>
          <label for='contact-last-name'>APELLIDO *</label>
          <input
            id='contact-last-name'
            name='last_name'
            type='text'
            autocomplete='family-name'
            minlength='2'
            maxlength='70'
            required
          />
        </div>
      </div>

      <div class='contact-form__row'>
        <div class='contact-form__field'>
          <label for='contact-email'>CORREO *</label>
          <input
            id='contact-email'
            name='contact_email'
            type='email'
            autocomplete='email'
            maxlength='190'
            required
          />
        </div>

        <div class='contact-form__field'>
          <label for='contact-phone'>TELÉFONO *</label>
          <div class='contact-form__phone-group'>
            <select
              name='country_code'
              aria-label='Código de país'
              autocomplete='tel-country-code'
              required
            >
              <option value='+52' selected>+52</option>
              <option value='+1'>+1</option>
            </select>

            <input
              id='contact-phone'
              name='contact_phone'
              type='tel'
              autocomplete='tel-national'
              inputmode='tel'
              maxlength='24'
              placeholder='55 1234 5678'
              required
            />
          </div>
        </div>
      </div>

      <div class='contact-form__field'>
        <label for='contact-project'>PROYECTO DE INTERÉS</label>
        <select id='contact-project' name='project_interest'>
          <option
            value='CONSULTA GENERAL'
            selected={selectedProject === 'CONSULTA GENERAL'}
          >
            CONSULTA GENERAL
          </option>
          {
            projects.map((project) => (
              <option
                value={project.value}
                selected={selectedProject === project.value}
              >
                {project.label}
              </option>
            ))
          }
        </select>
      </div>

      <div class='contact-form__field'>
        <label for='contact-message'>MENSAJE *</label>
        <textarea
          id='contact-message'
          name='message'
          rows='3'
          minlength='10'
          maxlength='2000'
          required
          placeholder='Cuéntanos cómo podemos ayudarte'></textarea>
      </div>

      <!-- Honeypot: fuera del flujo visual, pero detectable por bots. -->
      <div class='contact-form__trap' aria-hidden='true'>
        <label for='contact-website'>Deja este campo vacío</label>
        <input
          id='contact-website'
          name='website'
          type='text'
          tabindex='-1'
          autocomplete='off'
        />
      </div>

      <label class='contact-form__consent'>
        <input type='checkbox' name='privacy_consent' value='1' required />
        <span
          >Autorizo que Estrategia Urbana me contacte para dar seguimiento a
          esta solicitud.</span
        >
      </label>

      <button class='contact-form__submit' type='submit'>ENVIAR MENSAJE</button>
      <p
        class='contact-form__status'
        data-eu-contact-status
        role='status'
        aria-live='polite'
      >
      </p>
      <p class='contact-form__captcha-note'>
        Protegido con reCAPTCHA. Se aplican la política de privacidad y los
        términos de Google.
      </p>
    </form>
  </div>
</section>

<style>
  .contact-form {
    width: 100%;
    color: var(--color-white);
    background-color: var(--color-red);
  }

  .contact-form__layout {
    min-height: 700px;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    column-gap: clamp(72px, 8vw, 140px);
    align-items: center;
    padding-block: clamp(100px, 9vw, 148px);
  }

  .contact-form__intro {
    max-width: 590px;
  }
  .contact-form__eyebrow {
    margin: 0;
    font-family: var(--font-primary);
    font-size: clamp(0.8125rem, 0.9vw, 0.9375rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
  }
  .contact-form__title {
    margin: clamp(42px, 4vw, 56px) 0 0;
    max-width: 570px;
    font-size: clamp(3.75rem, 4.7vw, 5rem);
    font-weight: var(--font-weight-light);
    letter-spacing: -0.035em;
    line-height: 0.88;
  }
  .contact-form__title strong {
    display: block;
    font-weight: var(--font-weight-semibold);
  }
  .contact-form__description {
    max-width: 590px;
    margin: clamp(34px, 3vw, 44px) 0 0;
    font-family: var(--font-primary);
    font-size: clamp(1.125rem, 1.4vw, 1.5rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.22;
  }

  .contact-form__form {
    width: 100%;
    max-width: 520px;
    justify-self: end;
    display: flex;
    flex-direction: column;
  }
  .contact-form__row {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 24px;
  }
  .contact-form__field {
    display: flex;
    flex-direction: column;
    min-width: 0;
    margin-bottom: 30px;
  }
  .contact-form__field label {
    margin-bottom: 14px;
    font-family: var(--font-primary);
    font-size: 0.625rem;
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.2em;
    line-height: 1;
    color: var(--color-white);
    text-transform: uppercase;
  }

  .contact-form__phone-group {
    display: grid;
    grid-template-columns: 64px minmax(0, 1fr);
    gap: 12px;
    align-items: center;
  }

  .contact-form__phone-group > * {
    min-width: 0;
  }

  .contact-form__field :is(input, select, textarea) {
    width: 100%;
    min-height: 30px;
    padding: 0 0 7px;
    border: 0;
    border-bottom: 1px solid rgb(240 240 240 / 88%);
    border-radius: 0;
    outline: 0;
    color: var(--color-white);
    background: transparent;
    font-family: var(--font-primary);
    font-size: 1rem;
    font-weight: var(--font-weight-regular);
  }
  .contact-form__field select {
    cursor: pointer;
  }
  .contact-form__field select option {
    color: #222;
    background: #fff;
  }
  .contact-form__field textarea {
    min-height: 78px;
    resize: vertical;
    line-height: 1.4;
  }
  .contact-form__field :is(input, textarea)::placeholder {
    color: rgb(255 255 255 / 64%);
  }
  .contact-form__field :is(input, select, textarea):focus-visible {
    border-bottom-color: var(--color-white);
    outline: 1px solid var(--color-white);
    outline-offset: 3px;
  }
  .contact-form__trap {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    opacity: 0;
    pointer-events: none;
  }
  .contact-form__consent {
    display: flex;
    align-items: start;
    gap: 10px;
    font: 0.8125rem/1.45 var(--font-primary);
    cursor: pointer;
  }
  .contact-form__consent input {
    margin: 2px 0 0;
    accent-color: var(--color-white);
  }
  .contact-form__submit {
    width: fit-content;
    margin-top: 22px;
    padding: 13px 17px;
    border: 1px solid var(--color-white);
    color: var(--color-red);
    background-color: var(--color-white);
    font-family: var(--font-primary);
    font-size: 0.8125rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    line-height: 1;
    text-transform: uppercase;
    cursor: pointer;
    transition:
      color var(--duration-fast) var(--ease-premium),
      background-color var(--duration-fast) var(--ease-premium),
      transform var(--duration-fast) var(--ease-premium);
  }
  .contact-form__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .contact-form__status {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip-path: inset(50%);
    white-space: nowrap;
    border: 0;
  }
  .contact-form__captcha-note {
    margin: 24px 0 0;
    font: 0.6875rem/1.4 var(--font-primary);
    opacity: 0.74;
  }

  @media (hover: hover) and (pointer: fine) {
    .contact-form__submit:not(:disabled):hover {
      color: var(--color-white);
      background-color: transparent;
      transform: translateY(-2px);
    }
  }
  @media (max-width: 900px) {
    .contact-form__layout {
      min-height: 0;
      grid-template-columns: 1fr;
      row-gap: 80px;
      padding-block: 96px;
    }
    .contact-form__intro {
      max-width: 680px;
    }
    .contact-form__form {
      max-width: 680px;
      justify-self: start;
    }
  }
  @media (max-width: 767px) {
    .contact-form__layout {
      row-gap: 68px;
      padding-block: 84px 96px;
    }
    .contact-form__title {
      margin-top: 36px;
      font-size: clamp(3.25rem, 14vw, 4.5rem);
    }
    .contact-form__description {
      margin-top: 34px;
      font-size: 1.0625rem;
      line-height: 1.35;
    }
    .contact-form__row {
      grid-template-columns: 1fr;
      gap: 0;
    }
    .contact-form__field {
      margin-bottom: 25px;
    }
    .contact-form__submit {
      margin-top: 14px;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .contact-form__submit {
      transition: none;
    }
  }
</style>
