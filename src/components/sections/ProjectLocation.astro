---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  index: string;

  title: {
    lead: string;
    emphasis: string;
  };

  body: string[];

  projectName: string;

  logo: {
    image: ImageMetadata;
    alt: string;
  } | null;

  map: {
    center: {
      lat: number;
      lng: number;
    };

    zoom: number;
  } | null;
}

const { index, title, body, projectName, logo, map } = Astro.props;
---

<section id='location' class='project-location'>
  <div class='project-location__content page-shell'>
    <div class='project-location__editorial'>
      <div class='project-location__copy'>
        <span class='project-location__index'>
          {index}
        </span>

        <h2 class='project-location__title font-editorial'>
          <span>{title.lead}</span>
          <em>{title.emphasis}</em>
        </h2>

        <div class='project-location__body'>
          {body.map((paragraph) => <p>{paragraph}</p>)}
        </div>
      </div>

      <div class='project-location__brand'>
        {
          logo && (
            <Image
              src={logo.image}
              alt={logo.alt}
              class='project-location__logo'
              loading='lazy'
            />
          )
        }
      </div>
    </div>
  </div>

  {
    map && (
      <div
        class='project-location__map'
        data-project-location-map
        data-map-name={projectName}
        data-map-center-lat={map.center.lat}
        data-map-center-lng={map.center.lng}
        data-map-zoom={map.zoom}
        role='region'
        aria-label={`Ubicación de ${projectName}`}
      />
    )
  }
</section>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectLocationMap } from '../../scripts/ui/project-location-map';

  mountPageUI('[data-project-location-map]', initProjectLocationMap);
</script>

<style>
  .project-location {
    width: 100%;

    background-color: #e9e8e5;
  }

  /* =========================
     CONTENT
  ========================= */

  .project-location__content {
    padding-top: clamp(88px, 8vw, 128px);
    padding-bottom: clamp(88px, 8vw, 128px);
  }

  /* =========================
     EDITORIAL LAYOUT
  ========================= */

  .project-location__editorial {
    display: grid;

    grid-template-columns:
      minmax(0, 7fr)
      minmax(220px, 3fr);

    align-items: start;

    gap: clamp(48px, 6vw, 96px);
  }

  /* =========================
     BRAND / LOGO
  ========================= */

  .project-location__brand {
    display: flex;
    align-items: flex-start;
    justify-content: flex-end;

    min-width: 0;
  }

  .project-location__logo {
    display: block;

    width: min(100%, 280px);
    height: auto;
  }

  /* =========================
     EDITORIAL COPY
  ========================= */

  .project-location__copy {
    min-width: 0;
    max-width: 100%;
  }

  /* =========================
     INDEX
  ========================= */

  .project-location__index {
    display: block;

    margin-bottom: clamp(28px, 3vw, 40px);

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.13em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 62%);
  }

  /* =========================
     TITLE
  ========================= */

  .project-location__title {
    max-width: 100%;

    margin: 0;

    font-size: clamp(1.9rem, 2.5vw, 2.81rem);
    font-weight: var(--font-weight-light);

    line-height: 1;
    letter-spacing: -0.025em;

    color: var(--color-black);
  }

  .project-location__title span,
  .project-location__title em {
    display: block;
  }

  .project-location__title em {
    margin-top: 0.08em;

    font-weight: inherit;
    font-style: italic;

    color: var(--color-red);
  }

  /* =========================
     BODY
  ========================= */

  .project-location__body {
    display: grid;

    gap: 18px;

    max-width: 100%;

    margin-top: clamp(28px, 2.5vw, 36px);
  }

  .project-location__body p {
    margin: 0;

    font-family: var(--font-primary);
    font-size: clamp(0.9375rem, 1vw, 1.0625rem);

    line-height: 1.65;

    color: rgb(20 20 20 / 70%);
  }

  /* =========================
     MAP
  ========================= */

  .project-location__map {
    width: 100%;
    height: clamp(620px, 52vw, 800px);

    background-color: #f4f0eb;

    border-top: 1px solid rgb(20 20 20 / 10%);
  }

  /* =========================
     MAP PIN
  ========================= */

  :global(.project-location-pin) {
    position: absolute;

    width: 37px;
    height: 52px;

    margin-top: -52px;
    margin-left: -18.5px;

    transform-origin: bottom center;
  }

  :global(.project-location-pin svg) {
    display: block;

    width: 37px;
    height: 52px;
  }

  :global(.project-location-pin__label) {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;

    width: max-content;
    max-width: 240px;

    padding: 6px 10px;

    font-family: var(--font-primary);
    font-size: 0.75rem;

    line-height: 1.2;
    white-space: nowrap;

    color: var(--color-black);
    background-color: #fff;

    border-radius: 4px;

    box-shadow: 0 2px 8px rgb(0 0 0 / 16%);

    transform: translateX(-50%);
  }

  /* =========================
     TABLET
  ========================= */

  @media (min-width: 768px) and (max-width: 1199px) {
    .project-location__content {
      padding-top: 80px;
      padding-bottom: 88px;
    }

    .project-location__editorial {
      grid-template-columns:
        minmax(0, 65fr)
        minmax(220px, 35fr);

      gap: clamp(40px, 5vw, 64px);
    }

    .project-location__brand :global(svg),
    .project-location__brand :global(img) {
      max-width: min(100%, 280px);
      max-height: 150px;
    }

    .project-location__copy {
      max-width: 380px;
    }

    .project-location__title {
      font-size: clamp(1.5rem, 2.8vw, 2.25rem);
    }

    .project-location__map {
      height: 620px;
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-location__content {
      padding-top: 72px;
      padding-bottom: 76px;
    }

    .project-location__editorial {
      display: flex;
      flex-direction: column;

      gap: 48px;
    }

    .project-location__brand {
      width: 100%;
      min-height: 0;
    }

    .project-location__brand :global(svg),
    .project-location__brand :global(img) {
      max-width: min(72%, 240px);
      max-height: 130px;
    }

    .project-location__copy {
      width: 100%;
      max-width: 100%;
    }

    .project-location__index {
      margin-bottom: 28px;
    }

    .project-location__title {
      max-width: 100%;

      font-size: clamp(1.8rem, 8.4vw, 2.4rem);
    }

    .project-location__body {
      max-width: 100%;

      margin-top: 30px;
    }

    .project-location__map {
      height: 520px;
    }

    :global(.project-location-pin__label) {
      max-width: 180px;

      overflow: hidden;

      text-overflow: ellipsis;
    }
  }
</style>
