---
interface Props {
  index: string;

  title: {
    lead: string;
    emphasis: string;
  };

  body: string[];

  projectName: string;

  map: {
    center: {
      lat: number;
      lng: number;
    };

    zoom: number;
  } | null;
}

const { index, title, body, projectName, map } = Astro.props;
---

<section id='location' class='project-location'>
  <div class='project-location__content page-shell'>
    <div class='project-location__meta'>
      <span class='project-location__index'>
        {index}
      </span>

      <span class='project-location__project-name'>
        {projectName}
      </span>
    </div>

    <div class='project-location__editorial'>
      <h2 class='project-location__title font-editorial'>
        <span>{title.lead}</span>

        <em>{title.emphasis}</em>
      </h2>

      <div class='project-location__body'>
        {body.map((paragraph) => <p>{paragraph}</p>)}
      </div>
    </div>
  </div>

  {
    map && (
      <div
        class='project-location__map'
        data-project-location-map
        data-map-name={projectName}
        data-map-center-lat={map.center.lat}
        data-map-center-lng={map.center.lng}
        data-map-zoom={map.zoom}
        role='region'
        aria-label={`Ubicación de ${projectName}`}
      />
    )
  }
</section>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectLocationMap } from '../../scripts/ui/project-location-map';

  mountPageUI('[data-project-location-map]', initProjectLocationMap);
</script>

<style>
  .project-location {
    width: 100%;

    background-color: #e9e8e5;
  }

  /* =========================
     CONTENT
  ========================= */

  .project-location__content {
    padding-top: clamp(88px, 8vw, 128px);
    padding-bottom: clamp(88px, 8vw, 128px);
  }

  /* =========================
     META
  ========================= */

  .project-location__meta {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 32px;

    margin-bottom: clamp(42px, 5vw, 72px);
  }

  .project-location__index,
  .project-location__project-name {
    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.13em;

    text-transform: uppercase;

    color: rgb(20 20 20 / 62%);
  }

  .project-location__project-name {
    text-align: right;
  }

  /* =========================
     EDITORIAL
  ========================= */

  .project-location__editorial {
    display: grid;
    grid-template-columns:
      minmax(0, 2fr)
      minmax(260px, 0.8fr);

    align-items: end;

    gap: clamp(52px, 7vw, 120px);
  }

  /* =========================
     TITLE
  ========================= */

  .project-location__title {
    max-width: 980px;

    margin: 0;

    font-size: clamp(3.5rem, 5.8vw, 7rem);
    font-weight: var(--font-weight-light);

    line-height: 0.94;
    letter-spacing: -0.045em;

    color: var(--color-black);
  }

  .project-location__title span,
  .project-location__title em {
    display: block;
  }

  .project-location__title em {
    margin-top: 0.04em;

    font-weight: inherit;
    font-style: italic;

    color: var(--color-red);
  }

  /* =========================
     BODY
  ========================= */

  .project-location__body {
    display: grid;

    gap: 18px;

    max-width: 430px;

    padding-bottom: 0.35em;
  }

  .project-location__body p {
    margin: 0;

    font-family: var(--font-primary);
    font-size: clamp(0.9375rem, 1vw, 1.0625rem);

    line-height: 1.65;

    color: rgb(20 20 20 / 70%);
  }

  /* =========================
     MAP
  ========================= */

  .project-location__map {
    width: 100%;
    height: clamp(620px, 52vw, 800px);

    background-color: #f4f0eb;

    border-top: 1px solid rgb(20 20 20 / 10%);
  }

  /* =========================
     MAP PIN
  ========================= */

  :global(.project-location-pin) {
    position: absolute;

    width: 37px;
    height: 52px;

    margin-top: -52px;
    margin-left: -18.5px;

    transform-origin: bottom center;
  }

  :global(.project-location-pin svg) {
    display: block;

    width: 37px;
    height: 52px;
  }

  :global(.project-location-pin__label) {
    position: absolute;
    bottom: calc(100% + 8px);
    left: 50%;

    width: max-content;
    max-width: 240px;

    padding: 6px 10px;

    font-family: var(--font-primary);
    font-size: 0.75rem;
    line-height: 1.2;
    white-space: nowrap;

    color: var(--color-black);
    background-color: #fff;

    border-radius: 4px;

    box-shadow: 0 2px 8px rgb(0 0 0 / 16%);

    transform: translateX(-50%);
  }

  /* =========================
     TABLET
  ========================= */

  @media (min-width: 768px) and (max-width: 1199px) {
    .project-location__editorial {
      grid-template-columns:
        minmax(0, 1.6fr)
        minmax(240px, 0.8fr);

      gap: 48px;
    }

    .project-location__title {
      font-size: clamp(3.75rem, 7vw, 5.5rem);
    }

    .project-location__map {
      height: 620px;
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-location__content {
      padding-top: 72px;
      padding-bottom: 76px;
    }

    .project-location__meta {
      align-items: flex-start;

      margin-bottom: 36px;
    }

    .project-location__project-name {
      max-width: 50%;
    }

    .project-location__editorial {
      display: block;
    }

    .project-location__title {
      max-width: 100%;

      font-size: clamp(3rem, 13vw, 4.25rem);
    }

    .project-location__body {
      max-width: 100%;

      margin-top: 36px;
      padding-bottom: 0;
    }

    .project-location__map {
      height: 520px;
    }

    :global(.project-location-pin__label) {
      max-width: 180px;

      overflow: hidden;

      text-overflow: ellipsis;
    }
  }
</style>
