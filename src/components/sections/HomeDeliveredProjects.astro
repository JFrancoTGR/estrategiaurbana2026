---
import { Image } from 'astro:assets';

import deliveredProjectsImage from '../../assets/img/home/delivered-projects.webp';

const portfolioHref = `${import.meta.env.BASE_URL}portafolio`;
---

<section
  id='home-delivered-projects'
  class='home-delivered-projects'
  data-motion='home-delivered-projects'
>
  <div class='home-delivered-projects__layout'>
    <div class='home-delivered-projects__content'>
      <div class='home-delivered-projects__content-inner'>
        <p class='home-delivered-projects__eyebrow'>
          PROYECTOS ENTREGADOS
        </p>

        <h2 class='home-delivered-projects__title font-editorial'>
          Desarrollos que
          <span>respaldan nuestra palabra.</span>
        </h2>

        <p class='home-delivered-projects__description'>
          Nuestro portafolio construido refleja nuestra forma de desarrollar:
          con disciplina, diseño, calidad constructiva y un compromiso de largo
          plazo por entregar lo que prometemos.
        </p>

        <a
          class='home-delivered-projects__cta'
          href={portfolioHref}
        >
          VER PORTAFOLIO
        </a>
      </div>
    </div>

    <div
      class='home-delivered-projects__media'
      data-delivered-frame
    >
      <Image
        src={deliveredProjectsImage}
        alt='Proyecto entregado por Estrategia Urbana'
        class='home-delivered-projects__image'
        loading='lazy'
        data-delivered-image
      />
    </div>
  </div>
</section>

<style>
  .home-delivered-projects {
    position: relative;

    width: 100%;
    height: 100svh;
    min-height: 700px;

    overflow: hidden;

    color: var(--color-text);
    background-color: var(--color-background);

    border-top: 1px solid rgb(20 20 20 / 18%);
  }

  .home-delivered-projects__layout {
    width: 100%;
    height: 100%;

    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
  }

  /* CONTENT */

  .home-delivered-projects__content {
    min-width: 0;

    display: flex;
    align-items: center;
    justify-content: center;

    padding:
      clamp(56px, 6vw, 96px)
      var(--page-gutter);
  }

  .home-delivered-projects__content-inner {
    width: min(100%, 560px);

    display: flex;
    flex-direction: column;
    align-items: center;

    text-align: center;
  }

  .home-delivered-projects__eyebrow {
    margin: 0;

    font-family: var(--font-primary);
    font-size: clamp(0.8125rem, 0.9vw, 0.9375rem);
    font-weight: var(--font-weight-semibold);
    letter-spacing: 0.12em;
    line-height: 1;

    text-transform: uppercase;
  }

  .home-delivered-projects__title {
    max-width: 560px;

    margin:
      clamp(24px, 2.5vw, 36px)
      0
      0;

    font-size: clamp(2.5rem, 3.3vw, 4rem);
    font-weight: var(--font-weight-light);
    letter-spacing: -0.025em;
    line-height: 1.02;
  }

  .home-delivered-projects__title span {
    display: block;

    color: var(--color-red);
  }

  .home-delivered-projects__description {
    max-width: 500px;

    margin:
      clamp(30px, 3vw, 44px)
      0
      0;

    font-family: var(--font-primary);
    font-size: clamp(0.9375rem, 1.05vw, 1.0625rem);
    font-weight: var(--font-weight-regular);
    line-height: 1.38;
  }

  .home-delivered-projects__cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;

    min-height: 42px;

    margin-top: clamp(30px, 3vw, 42px);
    padding: 12px 22px;

    color: var(--color-white);
    background-color: var(--color-red);

    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: var(--font-weight-medium);
    letter-spacing: 0.1em;
    line-height: 1;
    text-decoration: none;
    text-transform: uppercase;

    transition:
      transform var(--duration-fast) var(--ease-premium),
      background-color var(--duration-fast) var(--ease-premium);
  }

  /* IMAGE VIEWPORT */

  .home-delivered-projects__media {
    position: relative;

    min-width: 0;
    height: 100%;

    overflow: hidden;

    background-color: var(--color-black);
  }

  .home-delivered-projects__image {
    position: absolute;

    top: 0;
    left: 0;

    width: 100%;
    height: auto;

    display: block;

    max-width: none;
  }

  @media (hover: hover) and (pointer: fine) {
    .home-delivered-projects__cta:hover {
      transform: translateY(-2px);
    }
  }

  /*
   * Tablet / mobile:
   * abandonamos pin + pan y recuperamos
   * una composición convencional.
   */
  @media (max-width: 1023px) {
    .home-delivered-projects {
      height: auto;
      min-height: 0;

      overflow: visible;
    }

    .home-delivered-projects__layout {
      grid-template-columns: 1fr;
    }

    .home-delivered-projects__content {
      min-height: 600px;

      padding-block: 96px;
    }

    .home-delivered-projects__media {
      height: auto;
      aspect-ratio: 4 / 5;
    }

    .home-delivered-projects__image {
      position: relative;

      width: 100%;
      height: 100%;

      object-fit: cover;
      object-position: center;
    }
  }

  @media (max-width: 767px) {
    .home-delivered-projects__content {
      min-height: 0;

      padding-block: 84px;
    }

    .home-delivered-projects__title {
      font-size: clamp(2.3rem, 10vw, 3.25rem);
    }

    .home-delivered-projects__description {
      font-size: 0.9375rem;
    }
  }

  /*
   * Sin motion: el frame sigue funcionando,
   * pero usamos un encuadre convencional.
   */
  @media (prefers-reduced-motion: reduce) and (min-width: 1024px) {
    .home-delivered-projects__image {
      width: 100%;
      height: 100%;

      object-fit: cover;
      object-position: center;
    }
  }
</style>