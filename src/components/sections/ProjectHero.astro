---
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface ProjectHeroStat {
  value: string;
  label: string;
}

interface Props {
  image: ImageMetadata;
  alt: string;

  title: string[];

  eyebrow: {
    primary: string;
    secondary?: string;
  };

  stats?: ProjectHeroStat[];

  cta?: {
    label: string;
    href: string;
  };
}

const { image, alt, title, eyebrow, stats = [], cta } = Astro.props;

const hasFooter = stats.length > 0 || Boolean(cta);
---

<section class='project-hero' data-motion='project-hero'>
  <Image
    src={image}
    alt={alt}
    class='project-hero__image'
    loading='eager'
    fetchpriority='high'
    data-anim='media'
  />

  <div class='project-hero__content page-shell'>
    <div class='project-hero__identity layout-grid'>
      <div class='project-hero__copy'>
        <p class='project-hero__eyebrow' data-anim='eyebrow'>
          <span class='project-hero__eyebrow-primary'>
            {eyebrow.primary}
          </span>

          {
            eyebrow.secondary && (
              <>
                <span
                  class='project-hero__eyebrow-separator'
                  aria-hidden='true'
                >
                  /
                </span>

                <span class='project-hero__eyebrow-secondary'>
                  {eyebrow.secondary}
                </span>
              </>
            )
          }
        </p>

        <h1 class='project-hero__title font-editorial' data-anim='title'>
          {title.map((line) => <span>{line}</span>)}
        </h1>
      </div>
    </div>

    {
      hasFooter && (
        <div class='project-hero__footer'>
          <div class='project-hero__divider' data-anim='divider' />

          <div class='project-hero__meta layout-grid'>
            {stats.length > 0 && (
              <div
                class='project-hero__stats'
                data-anim='stats'
                aria-label='Datos del proyecto'
              >
                {stats.map((stat) => (
                  <div class='project-hero__stat'>
                    <strong class='project-hero__stat-value font-editorial'>
                      {stat.value}
                    </strong>

                    <span class='project-hero__stat-label'>{stat.label}</span>
                  </div>
                ))}
              </div>
            )}

            {cta && (
              <a href={cta.href} class='project-hero__cta' data-anim='cta'>
                {cta.label}
              </a>
            )}
          </div>
        </div>
      )
    }
  </div>
</section>

<style>
  .project-hero {
    --project-hero-height: clamp(640px, 100svh, 900px);

    position: relative;

    width: 100%;
    min-height: var(--project-hero-height);

    overflow: hidden;

    color: var(--color-white);
    background-color: var(--color-black);
  }

  /* =========================
     MEDIA
  ========================= */

  .project-hero__image {
    position: absolute;
    z-index: 0;
    inset: 0;

    width: 100%;
    height: 100%;

    object-fit: cover;
    object-position: center;
  }

  /*
   * Contraste distribuido en tres zonas:
   *
   * 1. izquierda → identidad del proyecto;
   * 2. inferior → título, stats y CTA;
   * 3. superior → navbar overlay.
   */
  .project-hero::after {
    content: '';

    position: absolute;
    z-index: 1;
    inset: 0;

    background:
      linear-gradient(
        to right,
        rgb(0 0 0 / 64%) 0%,
        rgb(0 0 0 / 40%) 26%,
        rgb(0 0 0 / 15%) 54%,
        transparent 78%
      ),
      linear-gradient(
        to top,
        rgb(0 0 0 / 52%) 0%,
        rgb(0 0 0 / 20%) 38%,
        transparent 68%
      ),
      linear-gradient(
        to bottom,
        rgb(0 0 0 / 34%) 0%,
        rgb(0 0 0 / 8%) 24%,
        transparent 44%
      );

    pointer-events: none;
  }

  /* =========================
     CONTENT
  ========================= */

  .project-hero__content {
    position: relative;
    z-index: 2;

    min-height: var(--project-hero-height);

    display: flex;
    flex-direction: column;
    justify-content: flex-end;

    padding-top: calc(var(--header-height) + 64px);

    padding-bottom: clamp(56px, 5vw, 78px);
  }

  .project-hero__identity {
    width: 100%;

    margin-bottom: clamp(30px, 3vw, 44px);
  }

  .project-hero__copy {
    grid-column: 1 / span 8;
  }

  /* =========================
     EYEBROW
  ========================= */

  .project-hero__eyebrow {
    display: flex;
    align-items: center;
    gap: 9px;

    margin: 0;

    font-family: var(--font-primary);
    font-size: clamp(0.6875rem, 0.75vw, 0.8125rem);
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.16em;

    text-transform: uppercase;
  }

  .project-hero__eyebrow-primary {
    color: var(--color-red);
  }

  .project-hero__eyebrow-separator,
  .project-hero__eyebrow-secondary {
    color: var(--color-white);
  }

  .project-hero__eyebrow-separator {
    opacity: 0.72;
  }

  /* =========================
     TITLE
  ========================= */

  .project-hero__title {
    max-width: 930px;

    margin: clamp(30px, 2.8vw, 42px) 0 0;

    font-size: clamp(4.75rem, 6.7vw, 7rem);
    font-weight: var(--font-weight-regular);

    line-height: 0.88;
    letter-spacing: -0.045em;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 25%),
      0 4px 20px rgb(0 0 0 / 22%);
  }

  .project-hero__title span {
    display: block;
  }

  /* =========================
     FOOTER
  ========================= */

  .project-hero__footer {
    width: 100%;
  }

  .project-hero__divider {
    width: 100%;
    height: 1px;

    margin-bottom: clamp(28px, 2.4vw, 38px);

    background-color: rgb(240 240 240 / 48%);
  }

  .project-hero__meta {
    align-items: end;
  }

  /* =========================
     STATS
  ========================= */

  .project-hero__stats {
    grid-column: 1 / span 6;

    display: flex;
    align-items: flex-start;
    gap: clamp(52px, 7vw, 110px);
  }

  .project-hero__stat {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    min-width: 110px;
  }

  .project-hero__stat-value {
    font-size: clamp(2rem, 2.4vw, 2.75rem);
    font-weight: var(--font-weight-regular);

    line-height: 0.9;
    letter-spacing: -0.025em;
  }

  .project-hero__stat-label {
    margin-top: 9px;

    font-family: var(--font-primary);
    font-size: clamp(0.625rem, 0.7vw, 0.75rem);
    font-weight: var(--font-weight-regular);

    line-height: 1;
    letter-spacing: 0.12em;

    text-transform: uppercase;

    opacity: 0.72;
  }

  /* =========================
     CTA
  ========================= */

  .project-hero__cta {
    grid-column: 10 / -1;

    justify-self: end;

    display: inline-flex;
    align-items: center;
    justify-content: center;

    padding: 15px 24px;

    font-family: var(--font-primary);
    font-size: 0.75rem;
    font-weight: var(--font-weight-semibold);

    line-height: 1;
    letter-spacing: 0.09em;

    text-transform: uppercase;

    color: var(--color-white);
    background-color: var(--color-red);

    transition:
      transform var(--duration-fast) var(--ease-premium),
      background-color var(--duration-fast) var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-hero__cta:hover {
      transform: translateY(-2px);
    }
  }

  .project-hero__cta:focus-visible {
    outline: 1px solid var(--color-white);
    outline-offset: 4px;
  }

  /* =========================
     TABLET
  ========================= */

  @media (min-width: 768px) and (max-width: 1199px) {
    .project-hero {
      --project-hero-height: clamp(620px, 92svh, 820px);
    }

    .project-hero__content {
      padding-bottom: 56px;
    }

    .project-hero__copy {
      grid-column: 1 / span 7;
    }

    .project-hero__title {
      max-width: 760px;

      font-size: clamp(4.5rem, 8vw, 6rem);
    }

    .project-hero__stats {
      grid-column: 1 / span 5;

      gap: clamp(40px, 6vw, 72px);
    }

    .project-hero__cta {
      grid-column: 6 / -1;
    }
  }

  /* =========================
     MOBILE
  ========================= */

  @media (max-width: 767px) {
    .project-hero {
      --project-hero-height: clamp(620px, 100svh, 780px);
    }

    .project-hero::after {
      background:
        linear-gradient(
          to right,
          rgb(0 0 0 / 56%) 0%,
          rgb(0 0 0 / 22%) 70%,
          transparent 100%
        ),
        linear-gradient(
          to top,
          rgb(0 0 0 / 66%) 0%,
          rgb(0 0 0 / 28%) 46%,
          transparent 72%
        ),
        linear-gradient(to bottom, rgb(0 0 0 / 38%) 0%, transparent 38%);
    }

    .project-hero__content {
      padding-top: calc(var(--header-height) + 40px);
      padding-bottom: 40px;
    }

    .project-hero__identity {
      margin-bottom: 28px;
    }

    .project-hero__copy {
      grid-column: 1 / -1;
    }

    .project-hero__eyebrow {
      flex-wrap: wrap;

      font-size: 0.6875rem;
    }

    .project-hero__title {
      max-width: 100%;

      margin-top: 26px;

      font-size: clamp(3.6rem, 16vw, 5rem);

      line-height: 0.88;
    }

    .project-hero__divider {
      margin-bottom: 24px;
    }

    .project-hero__meta {
      row-gap: 30px;
    }

    .project-hero__stats {
      grid-column: 1 / -1;

      display: grid;
      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 24px;
    }

    .project-hero__stat {
      min-width: 0;
    }

    .project-hero__stat-value {
      font-size: 2.25rem;
    }

    .project-hero__stat-label {
      margin-top: 8px;

      font-size: 0.625rem;
    }

    .project-hero__cta {
      grid-column: 1 / -1;

      justify-self: start;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .project-hero__cta {
      transition: none;
    }
  }
</style>
