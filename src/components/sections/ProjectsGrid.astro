---
import { getCollection } from 'astro:content';

import ProjectCard from '../cards/ProjectCard.astro';

import {
  PROJECT_STATUS_META,
  COMMERCIAL_PROJECT_STATUS_VALUES,
} from '../../config/project-status';

const INITIAL_COUNT = 8;
const REVEAL_BATCH = 4;

const projects = (
  await getCollection(
    'projects',
    ({ data }) => data.commercial.available && Boolean(data.card),
  )
).sort((a, b) => {
  const orderA = a.data.home?.order ?? Number.MAX_SAFE_INTEGER;

  const orderB = b.data.home?.order ?? Number.MAX_SAFE_INTEGER;

  return orderA - orderB || a.data.name.localeCompare(b.data.name, 'es');
});

const hasMoreProjects = projects.length > INITIAL_COUNT;
---

<section
  class='projects-grid'
  data-projects-catalog
  data-motion='projects-grid'
  data-initial-count={INITIAL_COUNT}
  data-reveal-batch={REVEAL_BATCH}
>
  <div class='page-shell'>
    <div class='projects-grid__toolbar'>
      <span class='projects-grid__toolbar-label'> Filtrar por </span>

      <div class='projects-grid__filters'>
        <label class='projects-grid__filter'>
          <span class='projects-grid__filter-label'> Zona </span>

          <div class='projects-grid__select-wrap'>
            <select
              class='projects-grid__select'
              data-project-filter='market'
              aria-label='Filtrar proyectos por mercado'
            >
              <option value='all'>Todas</option>
              <option value='cdmx'>CDMX</option>
              <option value='tijuana'>Tijuana</option>
            </select>
          </div>
        </label>

        <label class='projects-grid__filter'>
          <span class='projects-grid__filter-label'> Estatus </span>

          <div class='projects-grid__select-wrap'>
            <select
              class='projects-grid__select'
              data-project-filter='status'
              aria-label='Filtrar proyectos por estatus'
            >
              <option value='all'> Todos </option>

              {
                COMMERCIAL_PROJECT_STATUS_VALUES.map((status) => (
                  <option value={status}>
                    {PROJECT_STATUS_META[status].label}
                  </option>
                ))
              }
            </select>
          </div>
        </label>
      </div>
    </div>

    <div id='projects-list' class='projects-grid__list' data-projects-list>
      {
        projects.map((project, index) => (
          <div
            class='projects-grid__item'
            data-project-card
            data-market={project.data.location.market}
            data-status={project.data.status}
            data-reveal-hidden={index >= INITIAL_COUNT ? '' : undefined}
          >
            <ProjectCard project={project} />
          </div>
        ))
      }
    </div>

    <div class='projects-grid__actions'>
      <button
        type='button'
        class='projects-grid__more'
        data-projects-more
        aria-controls='projects-list'
        hidden={!hasMoreProjects}
      >
        Ver más
      </button>
    </div>

    <p
      class='projects-grid__empty'
      data-projects-empty
      aria-live='polite'
      hidden
    >
      No hay proyectos que coincidan con los filtros seleccionados.
    </p>
  </div>
</section>

<style>
  .projects-grid {
    width: 100%;

    padding-block: clamp(52px, 5vw, 84px) clamp(72px, 6vw, 104px);

    background-color: var(--color-surface-muted);
  }

  /* ------------------------------
     Filters
  ------------------------------ */

  .projects-grid__toolbar {
    display: flex;
    align-items: flex-end;
    justify-content: flex-end;

    gap: 20px;

    margin-bottom: clamp(28px, 3vw, 44px);
  }

  .projects-grid__toolbar-label {
    padding-bottom: 11px;

    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }

  .projects-grid__filters {
    display: flex;
    align-items: flex-end;

    gap: 12px;
  }

  .projects-grid__filter {
    display: flex;
    flex-direction: column;

    gap: 6px;

    min-width: 150px;
  }

  .projects-grid__filter-label {
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: rgb(20 20 20 / 58%);
  }

  .projects-grid__select-wrap {
    position: relative;
  }

  .projects-grid__select-wrap::after {
    content: '';

    position: absolute;

    top: 50%;
    right: 14px;

    width: 6px;
    height: 6px;

    border-right: 1px solid var(--color-black);

    border-bottom: 1px solid var(--color-black);

    pointer-events: none;

    transform: translateY(-70%) rotate(45deg);
  }

  .projects-grid__select {
    width: 100%;

    padding: 10px 38px 10px 12px;

    font-family: var(--font-primary);

    font-size: 0.6875rem;
    line-height: 1.2;

    color: var(--color-black);
    background-color: transparent;

    border: 1px solid rgb(20 20 20 / 24%);

    border-radius: 0;

    appearance: none;

    cursor: pointer;
  }

  .projects-grid__select:focus-visible {
    outline: 1px solid var(--color-black);

    outline-offset: 2px;
  }

  /* ------------------------------
     Grid
  ------------------------------ */

  .projects-grid__list {
    display: grid;

    grid-template-columns: repeat(4, minmax(0, 1fr));

    gap: clamp(24px, 2.4vw, 38px) clamp(10px, 1.2vw, 18px);
  }

  .projects-grid__item {
    min-width: 0;
  }

  .projects-grid__item[hidden],
  .projects-grid__item[data-reveal-hidden] {
    display: none;
  }

  /* ------------------------------
     Actions
  ------------------------------ */

  .projects-grid__actions {
    display: flex;
    justify-content: center;

    margin-top: 36px;
  }

  .projects-grid__more {
    min-width: 126px;

    padding: 12px 22px;

    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.12em;

    text-align: center;
    text-transform: uppercase;

    color: var(--color-white);
    background-color: var(--color-black);

    border: 0;

    cursor: pointer;
  }

  .projects-grid__more[hidden] {
    display: none;
  }

  /* ------------------------------
     Empty state
  ------------------------------ */

  .projects-grid__empty {
    margin-top: 56px;

    font-size: 0.875rem;
    text-align: center;

    color: rgb(20 20 20 / 60%);
  }

  .projects-grid__empty[hidden] {
    display: none;
  }

  /* ------------------------------
     Tablet
  ------------------------------ */

  @media (min-width: 768px) and (max-width: 1199px) {
    .projects-grid__list {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  /* ------------------------------
     Mobile
  ------------------------------ */

  @media (max-width: 767px) {
    .projects-grid {
      padding-block: 48px 72px;
    }

    .projects-grid__toolbar {
      flex-direction: column;
      align-items: stretch;

      gap: 14px;

      margin-bottom: 28px;
    }

    .projects-grid__toolbar-label {
      padding-bottom: 0;
    }

    .projects-grid__filters {
      display: grid;

      grid-template-columns: repeat(2, minmax(0, 1fr));

      gap: 10px;
    }

    .projects-grid__filter {
      min-width: 0;
    }

    .projects-grid__list {
      grid-template-columns: 1fr;

      gap: 28px;
    }
  }
</style>

<script>
  import { mountPageUI } from '../../scripts/ui/page-lifecycle';

  import { initProjectsCatalog } from '../../scripts/ui/projects-catalog';

  mountPageUI('[data-projects-catalog]', initProjectsCatalog);
</script>
