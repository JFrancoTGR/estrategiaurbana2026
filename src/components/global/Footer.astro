---
import logo from '../../assets/img/logos/logo-marca.svg';

const navigation = [
  {
    label: 'Proyectos en Venta',
    href: '/proyectos-en-venta',
  },
  {
    label: 'Proyectos Entregados',
    href: '/proyectos-entregados',
  },
  {
    label: 'Socios Estratégicos',
    href: '/socios-estrategicos',
  },
  {
    label: 'Zonas',
    href: '/zonas',
  },
  {
    label: 'Contacto',
    href: '/contacto',
  },
];

const currentYear = new Date().getFullYear();
---

<footer class='site-footer'>
  <div class='page-shell site-footer__inner'>
    <div class='site-footer__main'>
      <div class='site-footer__brand'>
        <a
          href='/'
          class='site-footer__brand-link'
          aria-label='Estrategia Urbana — Inicio'
        >
          <img
            src={logo.src}
            alt='Estrategia Urbana'
            class='site-footer__logo'
          />
        </a>

        <p class='site-footer__statement'>
          Desarrollo inmobiliario con criterio.
        </p>
      </div>

      <nav
        class='site-footer__navigation'
        aria-label='Navegación de pie de página'
      >
        <ul class='site-footer__navigation-list'>
          {
            navigation.map((item) => (
              <li>
                <a href={item.href} class='site-footer__navigation-link'>
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div class='site-footer__contact'>
        <div class='site-footer__contact-copy'>
          <span class='site-footer__eyebrow'> Contacto </span>

          <a href='/contacto' class='site-footer__contact-link'>
            Hablemos de tu próximo proyecto
          </a>
        </div>

        <div class='site-footer__social' aria-label='Redes sociales'>
          <a
            href='#'
            class='site-footer__social-link'
            aria-label='Facebook'
            target='_blank'
            rel='noopener noreferrer'
          >
            <svg viewBox='0 0 24 24' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M13.5 22v-9h3l.5-3.5h-3.5V7.3c0-1 .3-1.8 1.8-1.8H17V2.3c-.3 0-1.4-.1-2.7-.1-2.7 0-4.6 1.7-4.6 4.8v2.5H6.6V13h3.1v9h3.8Z'
              ></path>
            </svg>
          </a>

          <a
            href='#'
            class='site-footer__social-link'
            aria-label='Instagram'
            target='_blank'
            rel='noopener noreferrer'
          >
            <svg viewBox='0 0 24 24' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M7.2 2h9.6A5.2 5.2 0 0 1 22 7.2v9.6a5.2 5.2 0 0 1-5.2 5.2H7.2A5.2 5.2 0 0 1 2 16.8V7.2A5.2 5.2 0 0 1 7.2 2Zm-.1 2A3.1 3.1 0 0 0 4 7.1v9.8A3.1 3.1 0 0 0 7.1 20h9.8a3.1 3.1 0 0 0 3.1-3.1V7.1A3.1 3.1 0 0 0 16.9 4H7.1ZM17.2 5.5a1.3 1.3 0 1 1 0 2.6 1.3 1.3 0 0 1 0-2.6ZM12 7.1A4.9 4.9 0 1 1 12 17a4.9 4.9 0 0 1 0-9.9Zm0 2A2.9 2.9 0 1 0 12 15a2.9 2.9 0 0 0 0-5.9Z'
              ></path>
            </svg>
          </a>

          <a
            href='#'
            class='site-footer__social-link'
            aria-label='LinkedIn'
            target='_blank'
            rel='noopener noreferrer'
          >
            <svg viewBox='0 0 24 24' aria-hidden='true'>
              <path
                fill='currentColor'
                d='M5.2 7.6H2V22h3.2V7.6ZM3.6 2A1.9 1.9 0 1 0 3.6 5.8 1.9 1.9 0 0 0 3.6 2ZM22 13.7c0-4.3-2.3-6.3-5.4-6.3a4.7 4.7 0 0 0-4.3 2.4V7.6H9.1V22h3.2v-7.1c0-1.9.4-3.7 2.7-3.7 2.3 0 2.3 2.1 2.3 3.8v7H22v-8.3Z'
              ></path>
            </svg>
          </a>
        </div>
      </div>
    </div>

    <div class='site-footer__bottom'>
      <p class='site-footer__copyright'>
        © {currentYear} Estrategia Urbana | México
      </p>

      <div class='site-footer__legal'>
        <a href='/aviso-de-privacidad'> Aviso de privacidad </a>        
      </div>
    </div>
  </div>
</footer>

<style>
  .site-footer {
    width: 100%;

    color: var(--color-white);
    background-color: var(--color-black);
  }

  .site-footer__inner {
    padding-top: clamp(48px, 5vw, 72px);

    padding-bottom: clamp(24px, 3vw, 36px);
  }

  /* ------------------------------
     Main
  ------------------------------ */

  .site-footer__main {
    display: grid;

    grid-template-columns:
      minmax(0, 1.4fr)
      minmax(0, 1fr)
      minmax(0, 1.1fr);

    gap: clamp(32px, 5vw, 80px);

    padding-bottom: clamp(44px, 5vw, 68px);
  }

  /* ------------------------------
     Brand
  ------------------------------ */

  .site-footer__brand {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 20px;
  }

  .site-footer__brand-link {
    display: block;
  }

  .site-footer__logo {
    display: block;

    width: auto;
    height: 50px;
  }

  .site-footer__statement {
    max-width: 250px;

    font-family: var(--font-editorial);

    font-size: clamp(1.15rem, 1.6vw, 1.5rem);

    font-weight: var(--font-weight-regular);

    line-height: 1.05;
    letter-spacing: -0.025em;

    color: rgb(240 240 240 / 72%);
  }

  /* ------------------------------
     Navigation
  ------------------------------ */

  .site-footer__navigation-list {
    display: flex;
    flex-direction: column;

    gap: 8px;
  }

  .site-footer__navigation-link {
    font-size: 0.75rem;
    font-weight: var(--font-weight-regular);

    line-height: 1.35;

    color: rgb(240 240 240 / 72%);

    transition: color var(--duration-fast) var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__navigation-link:hover {
      color: var(--color-white);
    }
  }

  /* ------------------------------
     Contact
  ------------------------------ */

  .site-footer__contact {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    gap: 28px;
  }

  .site-footer__contact-copy {
    display: flex;
    flex-direction: column;

    gap: 8px;
  }

  .site-footer__eyebrow {
    font-size: 0.625rem;
    font-weight: var(--font-weight-medium);

    line-height: 1;
    letter-spacing: 0.12em;
    text-transform: uppercase;

    color: rgb(240 240 240 / 48%);
  }

  .site-footer__contact-link {
    max-width: 260px;

    font-family: var(--font-editorial);

    font-size: clamp(1.25rem, 1.8vw, 1.65rem);

    line-height: 1.05;
    letter-spacing: -0.025em;

    color: var(--color-white);
  }

  /* ------------------------------
     Social
  ------------------------------ */

  .site-footer__social {
    display: flex;

    gap: 10px;
  }

  .site-footer__social-link {
    display: grid;
    place-items: center;

    width: 34px;
    height: 34px;

    color: rgb(240 240 240 / 72%);

    border: 1px solid rgb(240 240 240 / 22%);

    border-radius: 50%;

    transition:
      color var(--duration-fast) var(--ease-premium),
      border-color var(--duration-fast) var(--ease-premium),
      transform var(--duration-fast) var(--ease-premium);
  }

  .site-footer__social-link svg {
    width: 15px;
    height: 15px;
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__social-link:hover {
      color: var(--color-white);

      border-color: rgb(240 240 240 / 55%);

      transform: translateY(-2px);
    }
  }

  /* ------------------------------
     Bottom
  ------------------------------ */

  .site-footer__bottom {
    display: flex;
    align-items: center;
    justify-content: space-between;

    gap: 24px;

    padding-top: 20px;

    border-top: 1px solid rgb(240 240 240 / 14%);
  }

  .site-footer__copyright,
  .site-footer__legal {
    font-size: 0.625rem;
    line-height: 1.4;

    color: rgb(240 240 240 / 48%);
  }

  .site-footer__legal {
    display: flex;

    gap: 20px;
  }

  .site-footer__legal a {
    color: inherit;

    transition: color var(--duration-fast) var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .site-footer__legal a:hover {
      color: var(--color-white);
    }
  }

  /* ------------------------------
     Tablet
  ------------------------------ */

  @media (max-width: 1024px) {
    .site-footer__main {
      grid-template-columns: 1.2fr 1fr 1fr;

      gap: 36px;
    }
  }

  /* ------------------------------
     Mobile
  ------------------------------ */

  @media (max-width: 767px) {
    .site-footer__inner {
      padding-top: 44px;
    }

    .site-footer__main {
      grid-template-columns: 1fr;

      gap: 40px;

      padding-bottom: 44px;
    }

    .site-footer__logo {
      height: 56px;
    }

    .site-footer__statement {
      max-width: 220px;
    }

    .site-footer__bottom {
      flex-direction: column;
      align-items: flex-start;

      gap: 12px;
    }

    .site-footer__legal {
      flex-wrap: wrap;

      gap: 8px 18px;
    }
  }

  /* ------------------------------
     Reduced motion
  ------------------------------ */

  @media (prefers-reduced-motion: reduce) {
    .site-footer__navigation-link,
    .site-footer__social-link,
    .site-footer__legal a {
      transition: none;
    }
  }
</style>
