---
import logo from '../../assets/img/logos/logo-estrategia-urbana.svg';

const pathname = Astro.url.pathname;

const navigation = [
  {
    label: 'Proyectos en Venta',
    href: '/proyectos-en-venta',
  },
  {
    label: 'Proyectos Entregados',
    href: '/proyectos-entregados',
  },
  {
    label: 'Socios Estratégicos',
    href: '/socios-estrategicos',
  },
  {
    label: 'Zonas',
    href: '/zonas',
  },
  {
    label: 'Contacto',
    href: '/contacto',
  },
];

const isActive = (href: string) => {
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header class='site-header' data-site-header data-motion-preload>
  <div class='page-shell header-inner'>
    <a href='/' class='brand' aria-label='Estrategia Urbana — Inicio'>
      <img src={logo.src} alt='Estrategia Urbana' class='brand-logo' />
    </a>

    <nav class='main-navigation' aria-label='Navegación principal'>
      <ul class='navigation-list'>
        {
          navigation.map((item) => (
            <li class='navigation-item'>
              <a
                href={item.href}
                class:list={[
                  'navigation-link',
                  { active: isActive(item.href) },
                ]}
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const initializeHeader = () => {
    const header = document.querySelector('[data-site-header]');

    if (!(header instanceof HTMLElement)) return;

    const updateHeader = () => {
      header.classList.toggle('is-scrolled', window.scrollY > 16);
    };

    updateHeader();

    window.addEventListener('scroll', updateHeader, {
      passive: true,
    });
  };

  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', initializeHeader);
  } else {
    initializeHeader();
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;

    width: 100%;
    height: var(--header-height);

    color: var(--color-white);
    background: transparent;
    /* border-bottom: 1px solid transparent; */

    transition:
      height var(--duration-medium) var(--ease-premium),
      background-color var(--duration-medium) var(--ease-premium),
      border-color var(--duration-medium) var(--ease-premium),
      backdrop-filter var(--duration-medium) var(--ease-premium);
  }

  .site-header.is-scrolled {
    height: var(--header-height-scrolled);

    background-color: rgb(17 17 17 / 22%);
    /* border-bottom-color: rgb(255 255 255 / 100%); */

    backdrop-filter: blur(18px) saturate(125%);
    -webkit-backdrop-filter: blur(18px) saturate(125%);
  }

  .header-inner {
    display: grid;
    grid-template-columns: auto minmax(0, 1fr);

    align-items: center;
    column-gap: var(--header-brand-nav-gap);

    height: 100%;
  }

  /* ------------------------------
     Brand
  ------------------------------ */

  .brand {
    display: flex;
    align-items: center;

    width: fit-content;
    height: 100%;
  }

  .brand-logo {
    display: block;

    width: auto;
    height: 100%;
  }

  /* ------------------------------
     Navigation
  ------------------------------ */

  .main-navigation {
    min-width: 0;
    height: 100%;
  }

  .navigation-list {
    display: grid;
    grid-template-columns: repeat(5, minmax(0, 1fr));

    align-items: stretch;

    height: 100%;
    margin: 0;
  }

  .navigation-item {
    min-width: 0;
  }

  .navigation-link {
    position: relative;
    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    height: 100%;
    padding-inline: 1rem;

    font-size: 0.875rem;
    font-weight: var(--font-weight-medium);
    line-height: 1.1;
    text-align: center;

    color: var(--color-white);
    background-color: transparent;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 16%),
      0 2px 12px rgb(0 0 0 / 16%);

    transition: text-shadow var(--duration-fast) var(--ease-premium);
  }

  .navigation-link::before {
    content: '';

    position: absolute;
    z-index: -1;
    inset: 0;

    background-color: var(--color-red);

    transform: scaleY(0);
    transform-origin: bottom;

    transition: transform 350ms var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .navigation-link:hover::before {
      transform: scaleY(1);
    }

    .navigation-link:hover {
      text-shadow: none;
    }
  }

  .navigation-link:focus-visible::before,
  .navigation-link.active::before {
    transform: scaleY(1);
  }

  .navigation-link:focus-visible,
  .navigation-link.active {
    text-shadow: none;
  }

  .navigation-link:focus-visible {
    outline: 1px solid var(--color-white);
    outline-offset: -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .site-header,
    .navigation-link,
    .navigation-link::before {
      transition: none;
    }
  }
</style>
