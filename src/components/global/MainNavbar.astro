---
import logo from '../../assets/img/logos/logo-estrategia-urbana.svg';
import marca from '../../assets/img/logos/logo-marca.svg';

const pathname = Astro.url.pathname;

const navigation = [
  {
    label: 'Proyectos en Venta',
    href: '/proyectos-en-venta',
  },
  {
    label: 'Proyectos Entregados',
    href: '/proyectos-entregados',
  },
  {
    label: 'Socios Estratégicos',
    href: '/socios-estrategicos',
  },
  {
    label: 'Zonas',
    href: '/zonas',
  },
  {
    label: 'Contacto',
    href: '/contacto',
  },
];

const isActive = (href: string) => {
  return pathname === href || pathname.startsWith(`${href}/`);
};
---

<header
  class='site-header'
  data-site-header
  data-motion-preload
>
  <div class='page-shell header-inner'>
    <a
      href='/'
      class='brand'
      aria-label='Estrategia Urbana — Inicio'
    >
      <img
        src={logo.src}
        alt='Estrategia Urbana'
        class='brand-logo'
      />
    </a>

    <nav
      class='main-navigation'
      aria-label='Navegación principal'
    >
      <ul class='navigation-list'>
        {
          navigation.map((item) => (
            <li class='navigation-item'>
              <a
                href={item.href}
                class:list={[
                  'navigation-link',
                  {
                    active: isActive(item.href),
                  },
                ]}
                aria-current={
                  isActive(item.href)
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type='button'
      class='menu-toggle'
      data-menu-toggle
      aria-label='Abrir menú'
      aria-expanded='false'
      aria-controls='mobile-navigation'
    >
      <span class='menu-toggle__line'></span>
      <span class='menu-toggle__line'></span>
    </button>
  </div>

  <nav
    id='mobile-navigation'
    class='mobile-navigation'
    data-mobile-navigation
    aria-label='Navegación móvil'
    aria-hidden='true'
  >
    <div class='page-shell mobile-navigation__inner'>
      <ul class='mobile-navigation__list'>
        {
          navigation.map((item) => (
            <li class='mobile-navigation__item'>
              <a
                href={item.href}
                class:list={[
                  'mobile-navigation__link',
                  {
                    active: isActive(item.href),
                  },
                ]}
                aria-current={
                  isActive(item.href)
                    ? 'page'
                    : undefined
                }
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>

      <a
        href='/'
        class='mobile-navigation__brand'
        aria-label='Estrategia Urbana — Inicio'
      >
        <img
          src={marca.src}
          alt='Estrategia Urbana'
          class='mobile-navigation__logo'
        />
      </a>
    </div>
  </nav>
</header>

<script>
  import { initMobileNavigation } from '../../scripts/ui/mobile-navigation';

  const initializeHeader = () => {
    const header =
      document.querySelector(
        '[data-site-header]',
      );

    if (!(header instanceof HTMLElement)) {
      return;
    }

    const updateHeader = () => {
      header.classList.toggle(
        'is-scrolled',
        window.scrollY > 16,
      );
    };

    updateHeader();

    window.addEventListener(
      'scroll',
      updateHeader,
      {
        passive: true,
      },
    );

    initMobileNavigation(header);
  };

  if (document.readyState === 'loading') {
    document.addEventListener(
      'DOMContentLoaded',
      initializeHeader,
      {
        once: true,
      },
    );
  } else {
    initializeHeader();
  }
</script>

<style>
  .site-header {
    position: fixed;
    z-index: 1000;
    top: 0;
    left: 0;

    width: 100%;
    height: var(--header-height);

    color: var(--color-white);
    background: transparent;

    /* border-bottom: 1px solid transparent; */

    transition:
      height var(--duration-medium) var(--ease-premium),
      background-color var(--duration-medium) var(--ease-premium),
      /* border-color var(--duration-medium) var(--ease-premium), */
      backdrop-filter var(--duration-medium) var(--ease-premium);
  }

  .site-header.is-scrolled {
    height: var(--header-height-scrolled);

    background-color:
      rgb(17 17 17 / 22%);

    /* border-bottom-color: rgb(255 255 255 / 100%); */

    backdrop-filter:
      blur(18px)
      saturate(125%);

    -webkit-backdrop-filter:
      blur(18px)
      saturate(125%);
  }

  .header-inner {
    position: relative;
    z-index: 2;

    display: grid;
    grid-template-columns:
      auto
      minmax(0, 1fr);

    align-items: center;
    column-gap:
      var(--header-brand-nav-gap);

    height: 100%;
  }

  /* ------------------------------
     Brand
  ------------------------------ */

  .brand {
    display: flex;
    align-items: center;

    width: fit-content;
    height: 100%;

    transition:
      opacity 220ms var(--ease-premium),
      visibility 220ms;
  }

  .brand-logo {
    display: block;

    width: auto;
    height: 100%;
  }

  /* ------------------------------
     Desktop navigation
  ------------------------------ */

  .main-navigation {
    min-width: 0;
    height: 100%;
  }

  .navigation-list {
    display: grid;
    grid-template-columns:
      repeat(5, minmax(0, 1fr));

    align-items: stretch;

    height: 100%;
    margin: 0;
  }

  .navigation-item {
    min-width: 0;
  }

  .navigation-link {
    position: relative;

    isolation: isolate;
    overflow: hidden;

    display: flex;
    align-items: center;
    justify-content: center;

    height: 100%;
    padding-inline: 1rem;

    font-size: 0.875rem;
    font-weight:
      var(--font-weight-medium);
    line-height: 1.1;
    text-align: center;

    color: var(--color-white);
    background-color: transparent;

    text-shadow:
      0 1px 3px rgb(0 0 0 / 16%),
      0 2px 12px rgb(0 0 0 / 16%);

    transition:
      text-shadow
      var(--duration-fast)
      var(--ease-premium);
  }

  .navigation-link::before {
    content: '';

    position: absolute;
    z-index: -1;
    inset: 0;

    background-color:
      var(--color-red);

    transform: scaleY(0);
    transform-origin: bottom;

    transition:
      transform
      360ms
      var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .navigation-link:hover::before {
      transform: scaleY(1);
    }

    .navigation-link:hover {
      text-shadow: none;
    }
  }

  .navigation-link:focus-visible::before,
  .navigation-link.active::before {
    transform: scaleY(1);
  }

  .navigation-link:focus-visible,
  .navigation-link.active {
    text-shadow: none;
  }

  .navigation-link:focus-visible {
    outline:
      1px solid var(--color-white);

    outline-offset: -3px;
  }

  /* ------------------------------
     Mobile toggle
  ------------------------------ */

  .menu-toggle {
    position: relative;

    display: none;

    width: 44px;
    height: 44px;

    padding: 0;

    color: var(--color-white);
    background: transparent;
    border: 0;

    cursor: pointer;
  }

  .menu-toggle__line {
    position: absolute;

    left: 10px;

    width: 24px;
    height: 1px;

    background-color: currentColor;

    transition:
      top 360ms var(--ease-premium),
      transform 360ms var(--ease-premium);
  }

  .menu-toggle__line:first-child {
    top: 18px;
  }

  .menu-toggle__line:last-child {
    top: 25px;
  }

  .menu-toggle.is-active
    .menu-toggle__line:first-child {
    top: 22px;

    transform: rotate(45deg);
  }

  .menu-toggle.is-active
    .menu-toggle__line:last-child {
    top: 22px;

    transform: rotate(-45deg);
  }

  /* ------------------------------
     Mobile navigation
  ------------------------------ */

  .mobile-navigation {
    position: fixed;
    z-index: 1;
    inset: 0;

    display: none;

    width: 100%;
    height: 100dvh;

    color: var(--color-white);
    background-color:
      var(--color-red);

    opacity: 0;
    visibility: hidden;
    pointer-events: none;

    transform: translateY(-8px);

    transition:
      opacity
        360ms
        var(--ease-premium),
      transform
        420ms
        var(--ease-premium),
      visibility 420ms;
  }

  .mobile-navigation.is-open {
    opacity: 1;
    visibility: visible;
    pointer-events: auto;

    transform: translateY(0);
  }

  .mobile-navigation__inner {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    height: 100%;

    padding-top:
      calc(
        var(--header-height-scrolled) +
        35%
      );

    padding-bottom: 40px;
  }

  .mobile-navigation__list {
    display: flex;
    flex-direction: column;
    align-items: flex-start;

    width: 100%;
    margin: 0;
  }

  .mobile-navigation__item {
    width: 100%;
  }

  .mobile-navigation__link {
    display: inline-block;

    padding-block: 9px;

    font-family:
      var(--font-primary);

    font-size:
      clamp(
        1.5rem,
        7vw,
        2.25rem
      );

    font-weight:
      var(--font-weight-regular);

    line-height: 1.05;
    letter-spacing: -0.025em;
    text-align: left;

    color: var(--color-white);
  }

  .mobile-navigation__brand {
    display: block;

    width: fit-content;
    margin-top: auto;
  }

  .mobile-navigation__logo {
    display: block;

    width: auto;
    height: 80px;
  }

  /* ------------------------------
     Mobile breakpoint
  ------------------------------ */

  @media (max-width: 834px) {
    .header-inner {
      display: flex;
      align-items: center;
      justify-content: space-between;

      column-gap: 0;
    }

    .main-navigation {
      display: none;
    }

    .menu-toggle {
      display: block;
    }

    .mobile-navigation {
      display: block;
    }

    .site-header.menu-is-open {
      background-color: transparent;

      backdrop-filter: none;

      -webkit-backdrop-filter: none;
    }

    .site-header.menu-is-open
      .brand {
      opacity: 0;
      visibility: hidden;
    }
  }

  /* ------------------------------
     Reduced motion
  ------------------------------ */

  @media (
    prefers-reduced-motion: reduce
  ) {
    .site-header,
    .brand,
    .navigation-link,
    .navigation-link::before,
    .mobile-navigation,
    .menu-toggle__line {
      transition: none;
    }
  }

  :global(html.menu-open),
  :global(html.menu-open body) {
    overflow: hidden;
  }
</style>