---
import { SEO_CONFIG } from '../../config/seo';
import { withBase, withoutBase } from '../../utils/paths';

interface Props {
  title: string;
  description: string;

  ogTitle?: string;
  ogDescription?: string;

  ogImage?: string;
  ogImageAlt?: string;
}

const {
  title,
  description,

  ogTitle = title,
  ogDescription = description,

  ogImage = SEO_CONFIG.defaultImage.path,
  ogImageAlt = SEO_CONFIG.defaultImage.alt,
} = Astro.props;

/*
 * Entorno de publicación
 */
const isProduction =
  Astro.site?.origin === SEO_CONFIG.siteUrl && import.meta.env.BASE_URL === '/';

/*
 * Normalización de la ruta
 */
const pathname = withoutBase(Astro.url.pathname);

const normalizedPath =
  pathname === '/' ? '/' : `${pathname.replace(/\/+$/, '')}/`;

/*
 * URL canónica de producción
 */
const canonicalUrl = new URL(normalizedPath, SEO_CONFIG.siteUrl).href;

const ogImageUrl = new URL(
  withBase(ogImage),
  isProduction ? SEO_CONFIG.siteUrl : (Astro.site ?? Astro.url),
).href;
/*
 * Directivas de indexación
 */
const robots = isProduction
  ? SEO_CONFIG.robots.production
  : SEO_CONFIG.robots.staging;
---

<!-- Primary SEO -->
<title>{title}</title>

<meta name='description' content={description} />

<meta name='robots' content={robots} />

{isProduction && <link rel='canonical' href={canonicalUrl} />}

<!-- Open Graph -->

<meta property='og:type' content={SEO_CONFIG.ogType} />

<meta property='og:site_name' content={SEO_CONFIG.siteName} />

<meta property='og:locale' content={SEO_CONFIG.locale} />

<meta property='og:title' content={ogTitle} />

<meta property='og:description' content={ogDescription} />

<meta property='og:image' content={ogImageUrl} />

<meta property='og:image:type' content={SEO_CONFIG.defaultImage.type} />

<meta
  property='og:image:width'
  content={String(SEO_CONFIG.defaultImage.width)}
/>

<meta
  property='og:image:height'
  content={String(SEO_CONFIG.defaultImage.height)}
/>

<meta property='og:image:alt' content={ogImageAlt} />

{isProduction && <meta property='og:url' content={canonicalUrl} />}

<!-- Twitter / X Cards -->

<meta name='twitter:card' content={SEO_CONFIG.twitterCard} />

<meta name='twitter:title' content={ogTitle} />

<meta name='twitter:description' content={ogDescription} />

<meta name='twitter:image' content={ogImageUrl} />

<meta name='twitter:image:alt' content={ogImageAlt} />
