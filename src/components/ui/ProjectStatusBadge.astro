---
import {
  PROJECT_STATUS_META,
  type ProjectStatus,
} from '../../config/project-status';

interface Props {
  status: ProjectStatus;
}

const { status } = Astro.props;
const config = PROJECT_STATUS_META[status];
---

<button
  type='button'
  class='project-status'
  data-project-status
  aria-label={config.label}
  aria-expanded='false'
>
  <span class='project-status__label'>
    {config.label}
  </span>

  <span class='project-status__icon' aria-hidden='true'>
    {
      config.icon === 'construction' && (
        <svg viewBox='0 0 24 24'>
          <g fill='none' stroke='currentColor' stroke-width='1.5'>
            <path d='m13 11l5-5' />
            <path
              stroke-linejoin='round'
              d='m19 7l-2-2l2.5-1.5l1 1zM4.025 8.975a3.5 3.5 0 0 1-.79-3.74l1.422 1.422h2v-2L5.235 3.235a3.5 3.5 0 0 1 4.529 4.53l6.47 6.471a3.5 3.5 0 0 1 4.53 4.529l-1.421-1.422h-2v2l1.422 1.422a3.5 3.5 0 0 1-4.53-4.528L7.763 9.765a3.5 3.5 0 0 1-3.738-.79Z'
            />
            <path
              stroke-linejoin='round'
              d='m12.203 14.5l-5.604 5.604a1.35 1.35 0 0 1-1.911 0l-.792-.792a1.35 1.35 0 0 1 0-1.911L9.5 11.797'
            />
          </g>
        </svg>
      )
    }

    {
      config.icon === 'delivered' && (
        <svg viewBox='0 0 24 24'>
          <path
            fill='none'
            stroke='currentColor'
            stroke-linecap='round'
            stroke-linejoin='round'
            stroke-width='2'
            d='M3 21h18M10 4v17m-5 0V6.566a1 1 0 0 1 .486-.857l4.12-2.472a1 1 0 0 1 .83-.092l7.88 2.627a1 1 0 0 1 .684.949V21'
          />
        </svg>
      )
    }

    {
      config.icon === 'planning' && (
        <svg viewBox='0 0 2048 2048'>
          <path
            fill='currentColor'
            d='M1280 128h768v1920H0V37l1280 1280zM128 1920h1573L128 347zm1627-128l128 128h37V256h-512v128h256v128h-256v128h256v128h-256v128h384v128h-384v128h256v128h-256v128h256v128h-165l128 128h165v128zM384 1061l603 603H384zm128 310v165h165z'
          />
        </svg>
      )
    }
  </span>
</button>

<style>
  .project-status {
    display: inline-flex;
    align-items: center;
    justify-content: flex-end;

    height: 40px;
    min-width: 40px;

    padding: 0;

    overflow: hidden;

    font-family: var(--font-primary);
    font-size: 0.6875rem;
    font-weight: var(--font-weight-medium);
    line-height: 1;
    letter-spacing: 0.08em;
    text-transform: uppercase;

    color: var(--color-white);
    background-color: var(--color-red);
    border: 0;

    cursor: pointer;
  }

  .project-status__icon {
    flex: 0 0 40px;

    display: flex;
    align-items: center;
    justify-content: center;

    width: 45px;
    height: 45px;
  }

  .project-status__icon svg {
    width: 30px;
    height: 30px;

    fill: none;
    stroke: currentColor;
    stroke-width: 1.5;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .project-status__label {
    overflow: hidden;

    max-width: 0;

    padding-left: 0;

    opacity: 0;

    white-space: nowrap;

    transform: translateX(6px);

    transition:
      max-width 360ms var(--ease-premium),
      padding-left 360ms var(--ease-premium),
      opacity 220ms var(--ease-premium),
      transform 360ms var(--ease-premium);
  }

  @media (hover: hover) and (pointer: fine) {
    .project-status:hover .project-status__label,
    .project-status:focus-visible .project-status__label {
      max-width: 170px;

      padding-left: 14px;

      opacity: 1;

      transform: translateX(0);
    }
  }

  .project-status.is-expanded .project-status__label {
    max-width: 170px;

    padding-left: 14px;

    opacity: 1;

    transform: translateX(0);
  }

  .project-status:focus-visible {
    outline: 1px solid var(--color-white);
    outline-offset: -3px;
  }

  @media (prefers-reduced-motion: reduce) {
    .project-status__label {
      transition: none;
    }
  }
</style>

<script>
  import { initProjectStatusBadges } from '../../scripts/ui/project-status-badges';

  initProjectStatusBadges();
</script>
